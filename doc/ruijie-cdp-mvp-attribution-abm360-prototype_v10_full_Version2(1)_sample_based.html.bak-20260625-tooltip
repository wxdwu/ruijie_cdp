          <td class="tableMetric">${clickRate}%<div class="tableNote">${r.clicks}/${r.accounts.size}</div></td>
          <td class="tableMetric">${r.mql}</td>
          <td class="tableMetric">${r.sqlAccounts.size}</td>
          <td class="tableMetric">${r.dealAccounts.size}</td>
        </tr>
      `;
    }).join("") || `<tr><td colspan="10" class="hint">暂无数据</td></tr>`;
  };

