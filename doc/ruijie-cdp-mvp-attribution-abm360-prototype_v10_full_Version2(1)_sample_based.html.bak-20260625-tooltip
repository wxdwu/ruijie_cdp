    const recentClicks = recent7.filter(e=> ["内容点击","咨询","报名"].includes(e.type)).length;
    const riskFlags = [];
    if (crm.doNotDisturb) riskFlags.push("客户处于免打扰状态");
    if (crm.approvalStatus !== "已通过") riskFlags.push("审批状态未完成");
    if (crm.departmentalRiskWarning__c !== "无") riskFlags.push(`归属提示：${crm.departmentalRiskWarning__c}`);
    if (crm.sanctionRiskWarning__c === "中" || crm.sanctionRiskWarning__c === "高") riskFlags.push(`制裁风险：${crm.sanctionRiskWarning__c}`);

    const lostSummary = summarizeLostReasons(oppAll);
    let conclusion = `当前客户位于${account.specialName}的${account.stage}阶段，建议围绕${account.businessScenario}场景和${account.painPoints[0]}痛点继续推进。`;
    if (lostSummary.lostCount > 0){
      conclusion = `CRM出现 ${lostSummary.lostCount} 条取消/丢单记录，当前优先动作是围绕“${lostSummary.topReasons[0] || "采购节奏变化"}”做反制方案，再推进营销和销售协同。`;
    } else if (riskFlags.length){
      conclusion = `当前客户推进需要把风险、合规与商机节奏放在一起判断。现阶段最优先解决的是${riskFlags[0]}，否则即便继续营销触达，也难以顺利进入采购或成交。`;
    } else if (topOpp && ["方案","投标","谈判"].includes(topOpp.stage)){
      conclusion = `客户已进入${topOpp.stage}阶段，现阶段重点应从“获客”切换到“推动评审、采购和签约节奏”，优先围绕${topOpp.blocker_reason}做业务推进。`;
    } else if (account.intent_score >= 85 && recentClicks >= 2){
      conclusion = `客户意向已较明确，且近 7 天存在连续互动，适合用更针对性的行业案例和售前会，将线索推进到方案评审或预算确认。`;
    } else if (gaps.length){
      conclusion = `客户已有一定意向，但决策链和采购链还未闭环，当前最影响后续推进的是${gaps.map(g=>g.role).join("、")}尚未建立有效连接。`;
    }
    if (conclusion.length > 88){
      conclusion = conclusion.replace("当前客户推进需要把风险、合规与商机节奏放在一起判断。", "").trim();
    }

    const evidence = [
      `当前采购阶段：${account.stage}，销售阶段 ${account.pipelineStage}，意向度 ${account.intent_score}/100。`,
      `近 7 天互动 ${recent7.length} 次，其中高价值互动 ${recentClicks} 次。`,
      `单位标签：${account.customerTier}层 / ${account.customerStatus}。`,
      `业务标签：${account.demandType} / ${account.businessScenario} / ${account.painPoints.join("、")}`,
      `漏斗内金额 ${crm.sumMoneyInFunnel__c} 万，当前在漏斗内商机 ${crm.countInsideFunnel__c} 个。`,
      lostSummary.lostCount > 0 ? `CRM“取消或丢单”记录 ${lostSummary.lostCount} 条，主要原因：${lostSummary.topReasons.join("、")}。` : "CRM暂未发现取消/丢单记录。",
      topOpp ? `最大商机位于${topOpp.stage}阶段，金额 ${(topOpp.amount/10000).toFixed(0)} 万，当前阻塞为“${topOpp.blocker_reason}”。` : "当前无高优先级商机。",
      gaps.length ? `关键人缺口：${gaps.map(g=>g.role).join("、")}。` : "关键人链路基本齐备。",
      `审批状态：${crm.approvalStatus}；免打扰：${crm.doNotDisturb ? "是" : "否"}。`,
      `归属风险：${crm.departmentalRiskWarning__c}；制裁风险：${crm.sanctionRiskWarning__c}。`,
      riskFlags.length ? `风险/合规判断：${riskFlags.join("；")}。` : "当前未发现明显风险或合规阻断。"
    ];

    const contactInsights = buildContactInsights(account, conAll);
    const companyInsights = buildCompanyInsights(account, evs, oppAll, riskFlags, lostSummary);
    const nba = buildNbaRecommendations(account, contactInsights, gaps, topOpp, riskFlags, lostSummary);

    const actions = [];
    if (!crm.doNotDisturb && (account.intent_score >= 82 || recentClicks >= 2)){
      actions.push({type:"send_email", title:"发送营销邮件", desc:`向关键联系人发送 ${themes.join("、")} 资料包，推动进入下一轮沟通。`, button:"发送邮件"});
    }
    if (topOpp && ["SQL","方案","投标","谈判"].includes(topOpp.stage)){
      actions.push({type:"create_task", title:"创建售前推进任务", desc:`围绕“${topOpp.blocker_reason}”安排售前会或内部评审。`, button:"创建任务", taskTitle:`推进${topOpp.stage}商机：${topOpp.blocker_reason}`, dueDays:2});
      actions.push({type:"script", title:"查看拜访话术", desc:`结合竞品 ${competitor} 和主题 ${themes.join("、")} 生成沟通话术。`, button:"查看话术"});
    }
    if (gaps.length){
      actions.push({type:"gap_task", title:"补齐关键人", desc:`当前缺少 ${gaps.map(g=>g.role).join("、")}，建议先创建补齐任务。`, button:"创建补齐任务"});
      actions.push({type:"add_contact", title:"新增联系人", desc:`直接补充关键联系人，完善决策链和采购链。`, button:"新增联系人", roleNeed:gaps[0].role});
    }
    if (lostSummary.lostCount > 0){
      actions.push({type:"lost_reason_task", title:"创建丢单原因整改任务", desc:`围绕${lostSummary.topReasons[0] || "主要丢单原因"}制定整改动作并跟踪关闭。`, button:"创建整改任务"});
    }
    if (riskFlags.length){
      actions.push({type:"risk_task", title:"创建合规核验任务", desc:`围绕 ${riskFlags[0]} 发起内部核验，避免推进回退。`, button:"创建核验任务"});
    } else if (!crm.doNotDisturb && recent7.length===0 && account.intent_score>=70){
      actions.push({type:"send_sms", title:"发送短信提醒", desc:"最近 7 天无新互动，可通过短信/企业微信重启对话。", button:"发送短信"});
    }

    return {
      themes,
      competitor,
      gaps,
      topOpp,
      conclusion,
      evidence,
      contactInsights,
      companyInsights,
      nba,
      actions: actions.slice(0,3)
    };
  }

  function runInsightAction(account, insightPack, action, toEmails, toPhones){
    const keyTopics = insightPack.themes.join("、");
    const competitor = insightPack.competitor;
    if (action.type === "send_email"){
      openEmailEditorModal(account, toEmails, `【资料】${account.industry} + ${keyTopics}`, buildMailHtml(account, keyTopics, competitor));
      return;
    }
    if (action.type === "send_sms"){
      openSmsModal(account, toPhones);
      return;
    }
    if (action.type === "script"){
      openScriptModal(account, keyTopics, competitor);
      return;
    }
    if (action.type === "create_task"){
      createTaskForAccount(account, action.taskTitle || action.title, action.dueDays || 2);
      showToast("任务已创建");
      return;
    }
    if (action.type === "gap_task"){
      createTaskForAccount(account, `补齐：${insightPack.gaps.map(g=>g.role).join("、")}`, 2);
      showToast("补齐任务已创建");
      return;
    }
    if (action.type === "risk_task"){
      createTaskForAccount(account, "合规/风险核验", 1);
      showToast("核验任务已创建");
      return;
    }
    if (action.type === "lost_reason_task"){
      createTaskForAccount(account, "丢单原因整改复盘", 2);
      showToast("整改任务已创建");
      return;
    }
    if (action.type === "add_contact"){
      openAddContactModal(account, action.roleNeed || insightPack.gaps[0]?.role || "关键联系人");
    }
  }

  function renderMiniBars(values, labels){
    const max = Math.max(...values, 1);
    const bars = values.map(v=>{
      const h = Math.max(6, Math.round((v/max)*80));
      return `<div class="miniBar" style="height:${h}px"></div>`;
    }).join("");
    const labs = labels.map(l=>`<span>${escapeHtml(l)}</span>`).join("");
    return `
      <div class="miniBars">${bars}</div>
      <div class="miniLabelRow">${labs}</div>
    `;
  }

  function pickInteractionActor(e, content){
    const contacts = db.contacts.filter(c=> c.account_id === e.account_id);
    if (e.actor_contact_id){
      const matched = contacts.find(c=> c.contact_id === e.actor_contact_id);
      if (matched) return matched;
    }
    const title = (content?.title || e.note || "").trim();
    if (title){
      const byContent = contacts.find(c=> [c.contentInterest, c.productInterest].some(v=> String(v || "").includes(title)));
      if (byContent) return byContent;
    }
    if (contacts.length === 1) return contacts[0];
    const byChannel = contacts
      .filter(c=> String(c.preferred_channel || "").includes(e.channel))
      .sort((a,b)=> Number(b.interactionCount || 0) - Number(a.interactionCount || 0))[0];
    return byChannel || contacts.slice().sort((a,b)=> Number(b.interactionCount || 0) - Number(a.interactionCount || 0))[0] || null;
  }

  function buildInteractionSummary(e, campaignMap, contentMap){
    const campaign = campaignMap.get(e.campaign_id);
    const content = e.content_id ? contentMap.get(e.content_id) : null;
    const actor = pickInteractionActor(e, content);
    const actorName = actor?.name || (e.actor_name && e.actor_name !== "样例数据" ? e.actor_name : "未识别联系人");
    const actorRole = actor?.roleTag || actor?.role || (e.actor_role && e.actor_role !== "样例数据" ? e.actor_role : "样例来源");
    const contentTitle = content?.title || e.note || e.type || "无互动内容";
    const prefix = {
      "曝光": `客户在 ${e.channel} 渠道接收到一次曝光`,
      "触达": `客户通过 ${e.channel} 渠道被触达`,
      "点击": `客户对营销触点产生点击反馈`,
      "留资": `客户完成留资，进入可跟进状态`,
      "内容打开": `客户打开了营销内容`,
      "内容点击": `客户进一步点击了内容细节`,
      "咨询": `客户发起咨询，开始进入业务沟通`,
      "报名": `客户对活动产生报名动作`,
      "MQL": `客户已达到 MQL 判定阈值`,
      "SQL": `客户已进入 SQL 阶段，销售可介入推进`,
      "商机": `客户已形成明确商机，进入机会池`,
      "成交": `客户已形成成交结果，可回看转化链路`
    }[e.type] || `客户发生 ${e.type} 事件`;
    const extra = [];
    if (campaign?.name) extra.push(`归属专项 ${campaign.name}`);
    if (e.actor_role) extra.push(`来源表 ${e.actor_role}`);
    return { summary: prefix, extra: extra.join("；"), actorName, actorRole, contentTitle };
  }

