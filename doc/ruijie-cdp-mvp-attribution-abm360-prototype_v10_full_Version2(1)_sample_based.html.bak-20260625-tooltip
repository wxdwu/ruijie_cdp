        if (R() < 0.65) includedTemplates.push(campaign.roleTemplates.find(t=> t.roleTag === "使用者") || campaign.roleTemplates[0]);

        const uniqueTemplates = Array.from(new Map(includedTemplates.map(t=> [`${t.post}_${t.roleTag}`, t])).values()).slice(0, 5);
        uniqueTemplates.forEach((tpl, idx)=>{
          const mobile = `1${3+Math.floor(R()*6)}${String(Math.floor(R()*100000000)).padStart(8,"0")}`;
          const office = `0${10+Math.floor(R()*10)}-${String(1000000+Math.floor(R()*8999999))}`;
          const email = `contact${contactSeq}@example.com`;
          const contentMeta = pick(campaignContents);
          const crmContact = {
            id: `CRM_CON_${900000+contactSeq}`,
            contactName: `${tpl.post}_${account.name}_${idx+1}`,
            post: tpl.post,
            depart: tpl.chain === "采购链" ? pick(["采购部", "财务部"]) : (tpl.chain === "业务使用链" ? pick(["门诊部", "设备科", "生产信息部"]) : pick(["信息中心", "网络运维", "数字化办公室"])),
            mobile,
            officePhone__c: office,
            email,
            isVipRole__c: tpl.influence === "高" || tpl.roleTag === "拍板者" || tpl.roleTag === "决策者",
            doNotDisturb: R() < 0.08,
            contactScore: Math.floor(clamp((tpl.influence === "高" ? 88 : 72) + R()*14 - 5, 58, 98)),
            CurrentRelationshipLevel__c: pick(["一般", "较好", "良好", "紧密"]),
            Status__c: pick(["有效", "待验证", "有效"]),
            contactRole: tpl.roleTag,
            recentActivityRecordTime: toYMD(addDays(TODAY, -(1+Math.floor(R()*25))))
          };
          contacts.push({
            contact_id:`CON_${80000+contactSeq}`,
            account_id: account.account_id,
            industry: account.industry, // [?源字段] CRM 行业归属-新
            name: crmContact.contactName, // [?源字段] CRM 联系人名称
            role: crmContact.post, // [?源字段] CRM 职位
            roleTag: tpl.roleTag, // [*规则计算] 角色标签
            chainType: tpl.chain, // [*规则计算] 链类型
            influence: tpl.influence, // [*规则计算] 影响力等级
            preferred_channel: pick(["企业微信","邮件","电话"]), // [*规则计算] 随机选择
            last_interaction_days_ago: Math.floor(R()*35), // [*规则计算] 随机天数
            email, // [?源字段或衍生] 自动生成邮箱
            phone: mobile, // [?源字段或衍生] 自动生成手机号
            office_phone: office, // [?源字段或衍生] 自动生成办公电话
            purchaseStage, // [*规则计算] 继承自account.stage
            contentInterest: contentMeta.contentInterest, // [*规则计算] campaign内容兴趣
            productInterest: contentMeta.productInterest, // [*规则计算] campaign产品兴趣
            activityLevel: activityLevels[crmContact.contactScore >= 84 ? 0 : (crmContact.contactScore >= 70 ? 1 : 2)], // [*规则计算] 基于contactScore
            cooperationIntent, // [*规则计算] 继承自account
            dataSource: pick(dataSources), // [*规则计算] 随机数据源
            contactValidity: pick(contactValidityLevels), // [*规则计算] 随机有效性
            crm: crmContact, // [?CRM完整数据]
            reportsToId: "",
            relationType: relationTypes[tpl.chain] || "协同" // [*规则计算] 链类型映射
          });
          contactSeq += 1;
        });

        const oppCandidates = purchaseStage === "需求构建"
          ? ["SQL","方案","投标","谈判","成交"]
          : (purchaseStage === "解决方案探索" ? ["MQL","SQL","方案","投标"] : ["MQL","SQL","方案"]);
        const oppCount = 3 + Math.floor(R()*3);
        let topPipelineStage = account.pipelineStage;
        for (let j=0;j<oppCount;j++){
          const stage = pick(oppCandidates);
          const amount = Math.floor(18 + R()*280) * 10000;
          const probabilityBase = {"MQL":32,"SQL":50,"方案":64,"投标":72,"谈判":84,"成交":100,"流失":10}[stage] || 36;
          const lostLike = stage !== "成交" && R() < 0.30;
          const lostReason = pick(LOST_REASON_POOL);
          const blocker = stage === "成交"
            ? "已签约"
            : (lostLike ? lostReason : pick(["关键人未齐", "预算待确认", "方案评审未完成", "招采流程慢", "项目窗口待确定"]));
          const closeDays = stage === "成交" ? Math.floor(R()*8) : 7 + Math.floor(R()*68);
          const rank = {"MQL":1,"SQL":2,"方案":3,"投标":4,"谈判":5,"成交":6,"流失":0}[stage] || 0;
          const currentRank = {"MQL":1,"SQL":2,"方案":3,"投标":4,"谈判":5,"成交":6}[topPipelineStage] || 0;
          if (rank > currentRank) topPipelineStage = stage;
          opps.push({
            opp_id:`OPP_${90000 + opps.length + 1}`,
            account_id: account.account_id,
            stage,
            amount, // ?来源: CRM 金额(万)
            probability: Math.max(1, Math.min(100, probabilityBase + Math.floor(R()*15) - 7)), // ?规则: 基于阶段和CRM赢率计算
            close_days: closeDays,
            expected_close_date: toYMD(addDays(TODAY, closeDays)), // ?来源: CRM 预计下单日期
            blocker_reason: blocker,
            cancel_or_lost: lostLike ? pick(["7、客户取消采购计划", "8、已丢单"]) : "", // ?来源: CRM 取消/丢单列
            lost_reason: lostLike ? lostReason : "", // ?来源: CRM 丢单/取消原因说明（新）
            competitor: pickN(campaign.short === "彩光" ? ["H3C","Cisco","Huawei"] : ["H3C","Huawei","Cisco","Aruba"], R() < 0.7 ? 1 : 2)
          });
        }
        account.pipelineStage = topPipelineStage;

        const eventPlan = purchaseStage === "需求构建"
          ? ["曝光","触达","内容打开","内容点击","报名","咨询","留资","MQL","SQL","商机"]
          : (purchaseStage === "解决方案探索"
            ? ["曝光","触达","内容打开","点击","内容点击","报名","咨询","MQL"]
            : ["曝光","触达","内容打开","点击","内容打开","内容点击"]);
        const eventCount = eventPlan.length + Math.floor(R()*4);
        for (let e=0;e<eventCount;e++){
          const type = e < eventPlan.length ? eventPlan[e] : pick(eventPlan);
          const daysAgo = 4 + Math.floor(R()*84) - e;
          const content = (type.includes("内容") || type === "报名" || type === "咨询") ? pick(campaignContents) : null;
          const accountContacts = contacts.filter(c=> c.account_id===account.account_id);
          const actorContact = accountContacts[Math.floor(R()*Math.max(accountContacts.length, 1))] || null;
          interactions.push({
            event_id:`EVT_${100000+eventSeq}`,
            date: toYMD(addDays(TODAY, -Math.max(1, daysAgo))),
            time_hhmm: String(8+Math.floor(R()*10)).padStart(2,"0")+":"+String(Math.floor(R()*60)).padStart(2,"0"),
            account_id: account.account_id,
