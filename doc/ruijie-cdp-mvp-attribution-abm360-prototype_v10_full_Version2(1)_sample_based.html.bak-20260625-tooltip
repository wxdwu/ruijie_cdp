    const stageMax = Math.max(...stageRows.map(x=>x[1]), 1);
    renderBars($("stageDistChart"), stageRows.map(([name,count])=>({name, value:count/stageMax, label:`${count}家`})));
    const sourceCounter = new Map();
    scope.accs.forEach(a=> (a.sourceTables || []).forEach(s=> sourceCounter.set(s, (sourceCounter.get(s)||0)+1)));
    const srcRows = Array.from(sourceCounter.entries()).sort((a,b)=>b[1]-a[1]).slice(0,6);
    const srcMax = Math.max(...srcRows.map(x=>x[1]), 1);
    renderBars($("roleCoverageChart"), srcRows.map(([name,count])=>({name, value:count/srcMax, label:`${count}家`})));
    const productCounter = new Map();
    scope.accs.forEach(a=> (a.historyProductLines || []).forEach(t=> String(t).split(/[\/、,，\s]+/).filter(Boolean).slice(0,3).forEach(x=> productCounter.set(x,(productCounter.get(x)||0)+1))));
