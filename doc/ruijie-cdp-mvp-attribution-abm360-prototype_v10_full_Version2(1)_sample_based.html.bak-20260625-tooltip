  function getContactPushPlaybook(account, contact, history){
    const highValueCount = history.filter((event)=> ["内容点击","咨询","报名","SQL","商机"].includes(event.type)).length;
    const latest = history[0] || null;
    const roleBoost = ({"拍板者":22,"决策者":16,"采购推动者":13,"评估者":11,"技术把关者":10,"使用者":7}[contact?.roleTag] || 8);
    const stageBoost = ({"需求构建":18,"解决方案探索":11,"问题识别":6}[contact?.purchaseStage || account.stage] || 6);
    const baseScore = (contact?.crm?.contactScore || 70) + roleBoost + stageBoost + Math.min(highValueCount * 6, 24);
    const priorityScore = Math.max(55, Math.min(99, Math.round(baseScore)));

    const channel = contact?.preferred_channel || (highValueCount >= 3 ? "企业微信" : "邮件");
    const way = channel === "电话"
      ? "先电话对齐关键问题，再发送资料包确认下一步"
      : (channel === "企业微信"
        ? "先企业微信短消息破冰，再补一页要点图"
        : "先邮件发送结构化方案，再约 30 分钟沟通");
    const reason = [
      `${contact?.roleTag || "关键联系人"}在当前阶段影响成交节奏`,
      `近30天互动 ${history.length} 次，高价值行为 ${highValueCount} 次`,
      latest ? `最近一次行为为 ${latest.type}（${latest.date}）` : "暂缺历史行为，适合先做低干扰触达"
    ];
    const script = `您好${contact?.name || ""}，结合贵司当前“${account.businessScenario}”推进节奏，我们建议先围绕“${account.painPoints[0]}”做一次30分钟评估，现场会带上${account.historyProductLines[0]}相关案例与ROI测算，若方向一致可在本周进入下一步评审。`;

    return { priorityScore, reason, channel, way, script, highValueCount, latest };
  }

