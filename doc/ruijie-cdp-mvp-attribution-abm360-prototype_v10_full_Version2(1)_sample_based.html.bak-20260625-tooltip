  function renderContentRanking(campaignId){
    const scope = getCampaignScope(campaignId);
    const evs = scope.evs;

    const contentOpen = evs.filter(e=> e.type==="内容打开" && e.content_id);
    const contentClick = evs.filter(e=> e.type==="内容点击" && e.content_id);

    const byContent = new Map();
    const ensure = (id)=> (byContent.has(id)?byContent.get(id):(byContent.set(id,{open:0,click:0,mql:0,sql:0,won:0}), byContent.get(id)));
    contentOpen.forEach(e=> ensure(e.content_id).open++);
    contentClick.forEach(e=> ensure(e.content_id).click++);

    byContent.forEach((s)=>{
      s.mql = s.click>0 ? Math.min(s.click, Math.floor(s.click * (0.12 + R()*0.28))) : 0;
      s.sql = s.mql>0 ? Math.min(s.mql, Math.floor(s.mql * (0.35 + R()*0.30))) : 0;
      s.won = s.sql>0 ? Math.min(s.sql, Math.floor(s.sql * (0.12 + R()*0.18))) : 0;
    });

    const rows = Array.from(byContent.entries())
      .map(([cid,s])=>{
        const c = db.contents.find(x=>x.content_id===cid);
        const openRate = s.open>0 ? clamp(0.18 + R()*0.35, 0.1, 0.72) : 0;
