    });
    const cmpTone = (mine, peer, higherBetter=true)=>{
      if (!peer) return {tone:"hint", txt:"暂无同行基准"};
      const diff = mine - peer;
      const pctRaw = (diff/Math.max(1,peer))*100;
      const pct = Math.min(300, Math.max(-300, Math.round(pctRaw))); // 夹紧 ±300%
      const goodBad = (higherBetter ? diff>=0 : diff<=0);
      const sign = diff>=0 ? "高" : "低";
      const txt = Math.abs(pct) >= 300 ? `${sign}于同行均值 300%+` : `${sign}于同行均值 ${Math.abs(pct)}%`;
      return {
        tone: Math.abs(pct) < 8 ? "hint" : (goodBad ? "ok" : "warn"),
        txt
      };
    };
    const fmtWan = v=> `${Math.round(v||0)}万`;

    if (state.c360Tab==="biz"){
      // 1) 健康度 vs 同行雷达
      const myWin = crm.totalWonOpportunityAmount || 0;
