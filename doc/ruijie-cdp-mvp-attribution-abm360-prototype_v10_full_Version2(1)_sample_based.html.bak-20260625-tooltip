  const fmtBoolCN = (v)=> (v ? "是" : "否");
  function fieldLabel(apiName){ return (crmFieldDict[apiName] || apiName); }
  function escapeHtml(s){
    return String(s)
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
  }
  function kvLine(apiName, value){
    const cn = fieldLabel(apiName);
    const v = (typeof value==="boolean") ? fmtBoolCN(value) : (value ?? "-");
    return `
      <div class="kvLine">
        <div class="k">${escapeHtml(cn)}（${escapeHtml(apiName)}）</div>
        <div class="v">${escapeHtml(String(v))}</div>
      </div>
    `;
  }
  function kvText(label, value){
    return `
      <div class="kvLine">
        <div class="k">${escapeHtml(label)}</div>
        <div class="v">${escapeHtml(String(value ?? "-"))}</div>
      </div>
    `;
  }

