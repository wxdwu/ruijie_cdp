            </div>
            <div style="display:flex; align-items:center; gap:6px;">
              <div style="flex:1; height:8px; border-radius:2px; background:rgba(159,176,208,.10); overflow:hidden;">
                <div style="height:100%; width:${peerW}%; background:rgba(159,176,208,.55);"></div>
              </div>
              <span class="hint" style="font-size:11px; min-width:32px; text-align:right;">${it.peer}单</span>
            </div>
            <span class="hint" style="text-align:right; font-size:11px;">${it.mineAmt>0?`<b style="color:#ffb85a;">¥${it.mineAmt}万</b>`:"¥0"}</span>
