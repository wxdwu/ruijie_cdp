        if (p.crm.doNotDisturb === "是" || p.crm.doNotDisturb===true) n++;
        if (p.crm.departmentalRiskWarning__c && p.crm.departmentalRiskWarning__c !== "无") n++;
        if (["中","高"].includes(p.crm.sanctionRiskWarning__c)) n++;
        if (p.crm.duplicateFlg === "是" || p.crm.duplicateFlg===true) n++;
        return s+n;
      },0)/peers.length) : 0;
      const riskCmp = cmpTone(myRisks, peerRiskAvg, false); // less is better

      const levelClass = (lv)=> lv==="高"?"bad": lv==="中"?"warn":"hint";
      const cards = items.length ? items.map(it=>`
        <div class="riskCard" style="display:flex; gap:10px; padding:10px 12px; border:1px solid rgba(159,176,208,.18); border-radius:10px; margin-bottom:8px;">
