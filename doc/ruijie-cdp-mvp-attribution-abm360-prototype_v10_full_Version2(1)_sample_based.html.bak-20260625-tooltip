    const rejected = queue.filter(item=> item.status === "已驳回");
    const avgConfidence = pending.length ? Math.round(pending.reduce((sum,item)=> sum + item.confidence_score, 0) / pending.length * 100) : 0;
    const typeCounts = queue.reduce((map, item)=>{
      map.set(item.type, (map.get(item.type) || 0) + 1);
      return map;
    }, new Map());
    const typeOptions = ["全部", ...Array.from(typeCounts.keys())];
    if (!typeOptions.includes(state.reviewFilterType)) state.reviewFilterType = "全部";
    const visibleQueue = state.reviewFilterType === "全部" ? queue : queue.filter(item=> item.type === state.reviewFilterType);
    const reviewTypeStatsHtml = Array.from(typeCounts.entries()).map(([type, count])=>{
      return `<div class="reviewTypeStat"><div class="label">${escapeHtml(type)}</div><div class="value">${count}</div></div>`;
    }).join("");
    const reviewTypeChipsHtml = typeOptions.map((type)=>{
      const count = type === "全部" ? queue.length : (typeCounts.get(type) || 0);
