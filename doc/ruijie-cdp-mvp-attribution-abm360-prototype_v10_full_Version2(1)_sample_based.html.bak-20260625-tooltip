  function parseCustomerQuery(text){
    const q = text || "";
    const entities = {interactionMin:0, chips:[]};
    const add = (key, value, label)=>{ entities[key]=value; entities.chips.push({key, value, label}); };
    const campaign = db.campaigns.find(c=> q.includes(c.special) || q.includes(c.short) || (c.campaign_id.includes("MED") && /(医疗|医院|SMP|终端准入|EDN)/i.test(q)) || (c.campaign_id.includes("CG") && /(彩光|全光|光模块)/.test(q)));
    if (campaign) add("campaignId", campaign.campaign_id, `专项=${campaign.special}`);
    const industries = Array.from(new Set(db.accounts.map(a=>a.industry).filter(Boolean)));
    const industry = industries.find(x=> x !== "未知" && q.includes(x));
    if (industry) add("industry", industry, `行业=${industry}`);
    const provinces = Array.from(new Set(db.accounts.map(a=>a.region || a.province).filter(Boolean)));
    const province = provinces.find(x=> x !== "未知" && q.includes(x));
    if (province) add("province", province, `省份=${province}`);
    const owner = Array.from(new Set(db.accounts.map(a=>a.owner).filter(Boolean))).find(x=> x !== "未知" && q.includes(x));
    if (owner) add("owner", owner, `负责人=${owner}`);
    ["问题识别","解决方案探索","需求构建","线索","SQL","方案","投标","谈判","成交","已下单"].forEach(s=>{ if (!entities.stage && q.includes(s)) add("stage", s, `阶段=${s}`); });
    const acc = db.accounts.find(a=> a.name.length > 3 && q.includes(a.name));
    if (acc) add("text", acc.name, `客户=${acc.name}`);
    const m = q.match(/互动(?:次数)?(?:大于|超过|不少于|不低于|>=|≥)?\s*(\d+)/);
    if (m) add("interactionMin", Number(m[1]), `互动次数≥${m[1]}`);
    const amount = q.match(/金额(?:大于|超过|不少于|不低于|>=|≥)?\s*(\d+(?:\.\d+)?)/);
    if (amount) add("amountMin", Number(amount[1]), `金额≥${amount[1]}万`);
    if (/有商机|存在商机|商机客户/.test(q)) add("hasOpportunity", true, "有商机=是");
    if (/对单|已成交|已下单|成交客户/.test(q)) add("dealCustomer", true, "对单客户=是");
    ["官网","直播","邮件"].forEach(ch=>{ if (!entities.channel && q.includes(ch)) add("channel", ch, `渠道=${ch}`); });
    return entities;
  }

