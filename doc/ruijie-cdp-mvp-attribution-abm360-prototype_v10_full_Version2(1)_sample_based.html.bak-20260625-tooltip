      const arr = peers.map(fn).filter(v=> typeof v === "number" && !isNaN(v));
      if (!arr.length) return 0;
      return Math.round(arr.reduce((s,v)=>s+v,0)/arr.length);
    };
    const peerOpps = db.opps.filter(o=> {
      const p = db.accounts.find(x=> x.account_id===o.account_id);
