  renderCockpit = function(){
    const start30 = toYMD(addDays(TODAY, -30));
    const today = toYMD(TODAY);
    const periodEvents = (db.interactions || []).filter(e=> e.date >= start30 && e.date <= today);
    const activeAccountIds = new Set(periodEvents.map(e=>e.account_id));
    const openOpps = (db.opps || []).filter(o=> !["成交","流失"].includes(o.stage) && !o.lost);
    const pipelineWan = Math.round(openOpps.reduce((s,o)=> s + Number(o.amount || 0), 0) / 10000);
    const dealWan = Math.round((db.opps || []).filter(o=>o.stage==="成交" || Number(o.dealAmountWan||0)>0).reduce((s,o)=> s + Number(o.amount || 0), 0) / 10000);
    const accountScore = (a)=>{
      const ev30 = periodEvents.filter(e=>e.account_id===a.account_id).length;
      const opps = openOpps.filter(o=>o.account_id===a.account_id);
      const amt = opps.reduce((s,o)=>s+Number(o.amount||0),0)/10000;
      const overdue = (db.tasks || []).filter(t=>t.account_id===a.account_id && t.due < today && t.status!=="完成").length;
      return Math.round(ev30*2 + opps.length*10 + amt/10 + Number(a.intent_score||0)/2 + overdue*5);
    };
    const ranked = (db.accounts || []).map(a=>({a, score:accountScore(a)})).sort((x,y)=>y.score-x.score).slice(0,8);
    const focusIds = new Set(ranked.map(x=>x.a.account_id));
    const overdueTotal = (db.tasks || []).filter(t=>t.due < today && t.status!=="完成").length;
    $("cockpitKpis").innerHTML = `
      ${renderKpiCard("OPS-01", "管理客户数", (db.accounts || []).length.toLocaleString(), "统一客户去重总量", "tone-blue", "Accounts", {keys:["管理客户数"]})}
      ${renderKpiCard("OPS-02", "近30天互动客户", activeAccountIds.size.toLocaleString(), "2026/03/09-2026/04/08 有互动", "tone-cyan", "Active", {keys:["近30天互动客户"]})}
      ${renderKpiCard("OPS-03", "在途商机", openOpps.length.toLocaleString(), "未成交且未丢单 CRM 商机", "tone-green", "Open", {keys:["在途商机"]})}
      ${renderKpiCard("OPS-04", "在途金额", `¥${pipelineWan.toLocaleString()}万`, "在途商机金额汇总", "tone-blue", "Pipeline", {keys:["在途金额"]})}
      ${renderKpiCard("OPS-05", "已成交金额", `¥${dealWan.toLocaleString()}万`, `超期任务 ${overdueTotal} 条`, "tone-gold", "Won", {keys:["已成交金额","任务执行"]})}
    `;
    const byStage = new Map();
    openOpps.forEach(o=>byStage.set(o.stage || "未知", (byStage.get(o.stage || "未知")||0)+1));
    const stageRows = Array.from(byStage.entries()).sort((a,b)=>b[1]-a[1]);
    const stageMax = Math.max(...stageRows.map(x=>x[1]),1);
    const topStage = stageRows[0]?.[0] || "暂无";
    const byOwnerOverdue = new Map();
    (db.tasks || []).forEach(t=>{
      if (t.due < today && t.status !== "完成") byOwnerOverdue.set(t.owner, (byOwnerOverdue.get(t.owner)||0)+1);
    });
    const pressure = Array.from(byOwnerOverdue.entries()).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([o,n])=>`${o}${n}条`).join("、") || "当前无明显积压";
    $("cockpitBrief").className = "chartCard cockpitBriefCard";
    $("cockpitBrief").innerHTML = `
      <div class="chartHead">
        <div><div class="chartTitle">经营摘要 ${sourceTip("经营关注客户")}</div><div class="chartSub">基于样例客户、互动、CRM 商机和任务的管理视角</div></div>
        <div class="chartLegend">Sample-based cockpit</div>
      </div>
      <div class="briefOverview">
        <div class="briefLead">
          <div class="briefLeadTitle">经营结论</div>
          <div class="briefLeadText">最近 30 天有 ${activeAccountIds.size} 家客户产生互动，在途商机 ${openOpps.length} 个，主导阶段为 ${escapeHtml(topStage)}。当前执行压力集中在：${escapeHtml(pressure)}。</div>
          <div class="briefChipRow"><span class="badge">主阶段 ${escapeHtml(topStage)}</span><span class="badge">关注客户 ${ranked.length}家</span><span class="badge ${overdueTotal>0?'warn':'ok'}">超期 ${overdueTotal}</span></div>
        </div>
        <div class="briefFocusCard"><div class="briefFocusTitle">商机结构</div><div class="briefFocusMain">${escapeHtml(topStage)}</div><div class="briefFocusSub">按 CRM 预测类别/阶段聚合，聚焦未成交未丢单商机。</div></div>
        <div class="briefFocusCard"><div class="briefFocusTitle">任务压力</div><div class="briefFocusMain">${escapeHtml(pressure)}</div><div class="briefFocusSub">来自销售跟进任务 due/status 聚合。</div></div>
      </div>
      <div class="briefGrid">
        <div class="briefItem"><b>在途阶段分布 ${sourceTip("在途商机")}</b>
          ${stageRows.map(([name,count])=>`<div class="barRow"><div class="name">${escapeHtml(name)}</div><div class="barWrap"><div class="bar" style="width:${Math.round(count/stageMax*100)}%"></div></div><div class="val">${count}</div></div>`).join("") || `<div class="hint">暂无在途商机</div>`}
        </div>
        <div class="briefItem"><b>数据来源</b><div class="hint">客户来自统一客户聚合；互动来自 linkflow/内容/邮件/会话；金额与商机来自 CRM业务机会数据明细；任务来自样例跟进任务。</div></div>
      </div>
    `;
    renderPie($("cockpitChannelChart"), ["官网","直播","邮件"].map(name=>({name, value:periodEvents.filter(e=>e.channel===name).length})), "驾驶舱渠道互动", "近30天官网 / 直播 / 邮件互动次数");
    const industryRows = Array.from((db.accounts || []).reduce((map,a)=>{
      const cur = map.get(a.industry || "未知") || {name:a.industry || "未知", accounts:0, amount:0, ev:0};
      cur.accounts += 1;
      cur.amount += Number(a.amountWan || 0);
      cur.ev += periodEvents.filter(e=>e.account_id===a.account_id).length;
      map.set(cur.name, cur);
      return map;
    }, new Map()).values()).sort((a,b)=>b.amount-a.amount || b.ev-a.ev).slice(0,7);
    const indMax = Math.max(...industryRows.map(x=>x.amount || x.ev || x.accounts),1);
    renderBars($("cockpitIndustryChart"), industryRows.map(x=>({name:x.name, value:(x.amount || x.ev || x.accounts)/indMax, label:`${Math.round(x.amount)}万/${x.ev}次`})));
    $("cockpitHotAccRows").innerHTML = ranked.map((x,idx)=>{
      const a = x.a;
      const ev30 = periodEvents.filter(e=>e.account_id===a.account_id).length;
      const oppCount = openOpps.filter(o=>o.account_id===a.account_id).length;
      return `
        <div class="priorityItem">
          <div class="priorityRank"><div class="num">${idx+1}</div><div class="txt">TOP</div></div>
          <div>
            <div class="priorityTitle"><div class="priorityName">${escapeHtml(a.name)}</div><span class="badge">${x.score}分</span><span class="badge">${escapeHtml(a.owner || "-")}</span></div>
            <div class="priorityMeta"><span class="badge">${escapeHtml(a.special || "-")}</span><span class="badge">${escapeHtml(a.industry || "-")}</span><span class="badge warn">近30天互动 ${ev30}</span><span class="badge">在途商机 ${oppCount}</span></div>
            <div class="priorityReason">${escapeHtml(`关注分=近30天互动${ev30}*2 + 在途商机${oppCount}*10 + 金额/10 + 意向分/2；仅作管理排序依据。`)}</div>
          </div>
          <div class="priorityOps"><button class="btn primary" data-open360="${a.account_id}" data-from="cockpit">打开</button></div>
        </div>`;
    }).join("");
    const byOwner = new Map();
    (db.accounts || []).forEach(a=>byOwner.set(a.owner || "未知", {owner:a.owner || "未知", focus:0, todo:0, doneToday:0, overdue:0, focusAccounts:[]}));
    ranked.forEach(x=>{
      const row = byOwner.get(x.a.owner || "未知");
      if (row){ row.focus++; row.focusAccounts.push(x.a.name); }
    });
    (db.tasks || []).forEach(t=>{
      const row = byOwner.get(t.owner || "未知") || {owner:t.owner || "未知", focus:0,todo:0,doneToday:0,overdue:0,focusAccounts:[]};
      if (!byOwner.has(row.owner)) byOwner.set(row.owner,row);
      if (t.status==="完成" && t.done_at===today) row.doneToday++;
      if (t.status==="待办" || t.status==="延期"){
        if (t.due < today) row.overdue++;
        else row.todo++;
      }
    });
    document.querySelector('table[data-table-key="cockpitTasks"] thead tr').innerHTML = `<th>负责人${sourceTip("负责人")}</th><th>关注客户${sourceTip("经营关注客户")}</th><th>待跟进${sourceTip("任务执行")}</th><th>今日完成${sourceTip("任务执行")}</th><th>超期${sourceTip("任务执行")}</th><th>执行状态${sourceTip("任务执行")}</th>`;
    $("cockpitTasksRows").innerHTML = Array.from(byOwner.values()).sort((a,b)=>b.focus-a.focus || b.overdue-a.overdue).map(r=>`
      <tr>
        <td><b>${escapeHtml(r.owner)}</b></td>
        <td><span class="badge ${r.focus>=3?'warn':'ok'}">${r.focus}</span><div class="tableNote">${escapeHtml((r.focusAccounts || []).slice(0,2).join("、") || "-")}</div></td>
