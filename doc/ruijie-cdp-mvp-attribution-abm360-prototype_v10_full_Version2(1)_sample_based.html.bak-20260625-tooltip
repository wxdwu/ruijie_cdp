  function followReason(a, evs){
    const parts = [];
    const hit = evs.filter(e=>e.account_id===a.account_id).length;
    if (hit) parts.push(`窗口内互动${hit}次`);
    if (a.opportunityCount) parts.push(`商机${a.opportunityCount}个`);
    if (a.amountWan) parts.push(`金额${Number(a.amountWan||0).toLocaleString()}万`);
    if (a.stage && a.stage !== "未知") parts.push(`阶段${a.stage}`);
    return parts.join("；") || "样例数据不足，建议先核验联系人";
  }

