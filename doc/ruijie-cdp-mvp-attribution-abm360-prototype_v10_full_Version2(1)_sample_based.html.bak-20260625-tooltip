  function buildCampaignComparison(){
    return db.campaigns.map((cmp)=>{
      const scope = getCampaignScope(cmp.campaign_id);
      const funnel = db.funnels[cmp.campaign_id] || [];
      const won = funnel.find(x=>x.k==="成交")?.n || 0;
      const sql = funnel.find(x=>x.k==="SQL")?.n || 0;
      const highIntent = scope.accs.filter(a=> a.cooperationIntent === "高").length;
      const coverageGap = scope.accs.filter(a=> getCoverageStatus(a.account_id).missing.length > 0).length;
      return { cmp, won, sql, highIntent, coverageGap, accountCount: scope.accs.length };
    });
  }

  function getCampaignDisplayName(campaign){
    return campaign?.special || campaign?.name || campaign?.specialName || "当前专项";
  }

  function getAccountRecentEvents(accountId, days){
    const start = toYMD(addDays(TODAY, -days));
    return db.interactions.filter((e)=> e.account_id===accountId && e.date >= start);
  }

  function getAccountTopOpp(accountId){
    return db.opps.filter((o)=> o.account_id===accountId)
      .sort((a,b)=> (stageRank(b.stage)-stageRank(a.stage)) || (b.amount-a.amount))[0] || null;
  }

  function getAccountRiskSummary(account){
    const crm = account.crm;
    const items = [];
    if (crm.doNotDisturb) items.push("客户当前处于免打扰状态");
    if (crm.approvalStatus !== "已通过") items.push(`审批状态为${crm.approvalStatus}`);
    if (crm.departmentalRiskWarning__c !== "无") items.push(`存在${crm.departmentalRiskWarning__c}`);
    if (["中","高"].includes(crm.sanctionRiskWarning__c)) items.push(`制裁风险等级 ${crm.sanctionRiskWarning__c}`);
    if (crm.duplicateFlg) items.push("存在查重标记，需要先确认主体映射");
    return items;
  }

  function getAccountBudgetSummary(account){
    const crm = account.crm;
    const budgetItems = [
      {label:"LAN", value: crm.LANBudget__c},
      {label:"WAN", value: crm.WANBudget__c},
      {label:"数据中心", value: crm.DataCenterBudget__c},
      {label:"云桌面", value: crm.CloudDesktopBudget__c},
      {label:"智慧教室", value: crm.SmartClassroomBudget__c}
    ].sort((a,b)=> b.value-a.value);
    const totalCurrentOutput = crm.CurrentYearWirelessOutput__c + crm.CurrentYearRouterOutput__c + crm.CurrentYearSafeOutput__c;
    const topBudget = budgetItems[0];
    const secondBudget = budgetItems[1];
    const outputPressure = crm.ProductBudget__c > 0 ? Math.round(totalCurrentOutput / crm.ProductBudget__c * 100) : 0;
    return {budgetItems, topBudget, secondBudget, totalCurrentOutput, outputPressure};
  }

  function getAccountChannelSummary(account){
    const recent30 = getAccountRecentEvents(account.account_id, 30);
    const channelStats = Array.from(recent30.reduce((map, event)=> {
      map.set(event.channel, (map.get(event.channel)||0) + 1);
      return map;
    }, new Map()).entries()).sort((a,b)=> b[1]-a[1]);
    const highValue = recent30.filter((e)=> ["内容点击","咨询","报名","MQL","SQL","商机"].includes(e.type));
    return {recent30, channelStats, highValue};
  }

  function getRecommendedContents(account){
    const coverage = getCoverageStatus(account.account_id);
    const preferredPersona = coverage.missing[0] || (account.stage === "需求构建" ? "采购推动者" : (account.stage === "解决方案探索" ? "评估者" : "决策者"));
    const preferredInterest = account.stage === "需求构建" ? "落地实施" : (account.stage === "解决方案探索" ? "方案对比" : "成功案例");
    const campaignContents = db.contents.filter((content)=> content.campaign_id===account.campaign_id);
    const ranked = campaignContents.map((content)=>{
      let score = 0;
      if ((content.personaFit || "").includes(preferredPersona)) score += 4;
      if (content.contentInterest === preferredInterest) score += 3;
      if (account.historyProductLines.includes(content.productInterest)) score += 2;
      if ((content.title || "").includes(account.special)) score += 1;
      return {content, score};
    }).sort((a,b)=> b.score-a.score).slice(0,3);
    return {preferredPersona, preferredInterest, ranked};
  }

  function getCampaignTagSummary(campaignId){
    const scope = getCampaignScope(campaignId);
    const tagMap = new Map();
    scope.accs.forEach((account)=>{
      [account.demandType, account.businessScenario, ...account.painPoints.slice(0,2), ...account.tags.slice(0,3)].forEach((tag)=>{
        tagMap.set(tag, (tagMap.get(tag)||0) + 1);
      });
    });
    return Array.from(tagMap.entries()).sort((a,b)=> b[1]-a[1]).slice(0,6);
  }

  function getCampaignRiskAccounts(campaignId){
    return getCampaignScope(campaignId).accs.map((account)=> ({account, risks:getAccountRiskSummary(account)}))
      .filter((item)=> item.risks.length)
      .sort((a,b)=> b.risks.length-a.risks.length || b.account.intent_score-a.account.intent_score)
      .slice(0,4);
  }

  function getCampaignContentSummary(campaignId){
    const scope = getCampaignScope(campaignId);
    const stats = new Map();
    scope.contents.forEach((content)=> stats.set(content.content_id, {content, open:0, click:0}));
    scope.evs.forEach((event)=>{
      if (!event.content_id || !stats.has(event.content_id)) return;
      const row = stats.get(event.content_id);
      if (event.type === "内容打开") row.open++;
      if (event.type === "内容点击") row.click++;
    });
    return Array.from(stats.values()).sort((a,b)=> b.click-a.click || b.open-a.open).slice(0,4);
  }

  function getOwnerFocusSummary(){
    const today = toYMD(TODAY);
    return owners.map((owner)=>{
      const overdue = db.tasks.filter((task)=> task.owner===owner && ["待办","延期"].includes(task.status) && task.due < today).length;
      const highIntent = db.accounts.filter((account)=> account.owner===owner && account.intent_score >= 85).length;
      const roleGap = db.accounts.filter((account)=> account.owner===owner && getCoverageStatus(account.account_id).missing.length > 0).length;
      return {owner, overdue, highIntent, roleGap};
    }).sort((a,b)=> b.overdue-a.overdue || b.highIntent-a.highIntent).slice(0,5);
  }

  function hasAiUserMessages(){
    return state.aiChatMessages.some((msg)=> msg.role === "user");
  }

  function syncAiGuideVisibility(){
    const examples = $("aiDrawerExamples");
    const side = examples?.parentElement;
    if (!examples || !side) return;
    const hideGuide = hasAiUserMessages();
    examples.classList.toggle("is-hidden", hideGuide);
    side.classList.toggle("compact", hideGuide);
  }

