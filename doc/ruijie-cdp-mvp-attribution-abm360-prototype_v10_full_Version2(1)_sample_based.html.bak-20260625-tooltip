            actor_role: actorContact?.roleTag || (type === "曝光" ? "系统触达" : "流程节点"),
            channel: pick(type === "报名" || type === "咨询" ? ["官网", "智趣", "直播"] : channels),
            type,
            content_id: content ? content.content_id : null,
            note: content ? `关联「${content.title}」；标签 ${content.contentInterest} / ${content.productInterest}` : `按 ${campaign.special} 规则识别为 ${purchaseStage}`
          });
          eventSeq += 1;
        }

        accountSeq += 1;
      }

      const funnel = genFunnelRealistic();
      if (campaign.short === "医疗") funnel[0].n = Math.floor(funnel[0].n * 0.72);
      funnels[campaign.campaign_id] = funnel;

      const rawAttr = campaign.short === "彩光"
        ? [
            {channel:"官网", w:0.24 + R()*0.10},
            {channel:"邮件", w:0.20 + R()*0.08},
            {channel:"直播", w:0.18 + R()*0.08},
            {channel:"企业微信", w:0.16 + R()*0.06},
            {channel:"市场活动", w:0.12 + R()*0.06},
            {channel:"智趣", w:0.08 + R()*0.05}
          ]
        : [
            {channel:"官网", w:0.20 + R()*0.10},
            {channel:"直播", w:0.22 + R()*0.08},
            {channel:"智趣", w:0.20 + R()*0.08},
            {channel:"邮件", w:0.14 + R()*0.06},
            {channel:"企业微信", w:0.12 + R()*0.05},
            {channel:"市场活动", w:0.10 + R()*0.05}
          ];
      normalize(rawAttr);
      attributions[campaign.campaign_id] = {won: rawAttr};
    });

    const reviewTypeBlueprints = [
      {
        type: "公司主体冲突",
        matchedThrough: "公司名 + 统一社会信用代码局部命中",
        queueReason: "公司名高度相似，但法人主体与区域信息存在偏差，需要确认是否收敛到同一客户主数据。",
        sourceSystems: ["CRM客户表", "官网留资表", "智趣百川表单"],
        approveLabel: "确认主体合并",
        rejectLabel: "保留独立主体",
        approveResult: "已确认主体合并，允许回写主客户档案与 OneID 主映射。",
        rejectResult: "已确认保留独立主体，加入主体黑名单避免再次自动合并。",
        build(account, idx, contactsForAccount){
          const variantName = account.name.replace(/_\d+$/, idx % 2 === 0 ? "_集团" : "_有限公司");
          return {
            subject: `${account.name} ⇄ ${variantName}`,
            left: {
              title: "候选主体 A",
              name: account.name,
              fields: [
                {label:"行业 / 区域", value:`${account.industry} / ${account.region}`},
                {label:"负责人", value:account.owner},
                {label:"统一社会信用代码", value:account.crm.UniformSocialCreditCode__c},
                {label:"关键联系人", value:contactsForAccount.map(c=> `${c.name} / ${c.roleTag}`).join("；") || "-"}
              ]
            },
            right: {
              title: "候选主体 B",
              name: variantName,
              fields: [
                {label:"行业 / 区域", value:`${account.industry} / ${idx % 2 === 0 ? account.region : pick(regions)}`},
                {label:"负责人", value:idx % 2 === 0 ? account.owner : pick(owners)},
                {label:"统一社会信用代码", value:idx % 2 === 0 ? account.crm.UniformSocialCreditCode__c : "缺失"},
                {label:"关键联系人", value:contactsForAccount.map(c=> `${c.name} / ${c.roleTag}`).reverse().join("；") || "-"}
              ]
            },
            evidence: [
              `专项：${account.specialName}；客户分层 ${account.customerTier}；合作意向 ${account.cooperationIntent}`,
              `左侧主体最近 30 天互动 ${interactions.filter(e=> e.account_id===account.account_id).length} 次；当前阶段 ${account.pipelineStage}`,
              `右侧主体来自 ${idx % 2 === 0 ? "官网/表单补录" : "外部线索同步"}，名称后缀与区域归属存在差异`
            ]
          };
        }
      },
      {
        type: "联系人冲突",
        matchedThrough: "手机号脱敏 + 邮箱前缀模糊匹配",
        queueReason: "联系人身份相似，但所属客户、角色标签与活跃来源不一致，需要人工确认是否为同一人。",
        sourceSystems: ["CRM联系人表", "营销活动报名表", "企业微信线索"],
        approveLabel: "确认联系人合并",
        rejectLabel: "保留独立联系人",
        approveResult: "已确认联系人合并，保留完整互动轨迹并同步主联系人档案。",
        rejectResult: "已确认保留独立联系人，后续不再自动触发联系人合并。",
        build(account, idx, contactsForAccount){
          const leftContact = contactsForAccount[0] || contacts.find(c=> c.account_id===account.account_id);
          const rightContact = contactsForAccount[1] || contacts.find(c=> c.contact_id!==leftContact?.contact_id) || leftContact;
          const altAccount = accounts.find(a=> a.account_id!==account.account_id && a.special===account.special) || account;
          return {
            subject: `${leftContact?.name || "联系人A"} ⇄ ${rightContact?.name || "联系人B"}`,
            left: {
              title: "联系人 A",
              name: leftContact?.name || "待识别联系人",
              fields: [
                {label:"所属客户", value:account.name},
                {label:"角色标签", value:leftContact?.roleTag || "-"},
                {label:"手机号", value:leftContact?.phone || "-"},
