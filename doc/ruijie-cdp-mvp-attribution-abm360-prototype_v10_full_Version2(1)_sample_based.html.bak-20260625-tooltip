  function formatSourceHelp(text){
    const raw = String(text || "");
    const parts = raw.split(/[；;]/).map(x=>x.trim()).filter(Boolean);
    if (!parts.length) return `<div class="sourceHelpText">${escapeHtml(raw || "字段来自样例数据聚合。")}</div>`;
    return `<div class="sourceHelpGrid">${parts.map(part=>{
      const idx = Math.max(part.indexOf("："), part.indexOf(":"));
      if (idx <= 0) return `<div class="sourceHelpText">${escapeHtml(part)}</div>`;
      const key = part.slice(0, idx).trim();
      const val = part.slice(idx + 1).trim();
      return `<div class="sourceHelpRow"><span>${escapeHtml(key)}</span><b>${escapeHtml(val || "-")}</b></div>`;
    }).join("")}</div>`;
  }

  function sourceTip(key){
    const text = FIELD_SOURCES[key] || key || "字段来自样例数据聚合。";
    return `<span class="sourceHelp" tabindex="0"><button type="button" class="sourceHelpTrigger" aria-label="查看${escapeHtml(key)}字段口径" title="查看字段口径">?</button><span class="sourceHelpCard" role="tooltip"><span class="sourceHelpKicker">字段口径</span><strong>${escapeHtml(key)}</strong>${formatSourceHelp(text)}</span></span>`;
  }

  document.addEventListener("click", (event)=>{
    const trigger = event.target?.closest?.(".sourceHelpTrigger");
    document.querySelectorAll(".sourceHelp.isPinned").forEach(item=>{
      if (!item.contains(event.target)) item.classList.remove("isPinned");
    });
    if (trigger){
      event.preventDefault();
      event.stopPropagation();
      const host = trigger.closest(".sourceHelp");
      const wasPinned = host?.classList.contains("isPinned");
      document.querySelectorAll(".sourceHelp.isPinned").forEach(item=>item.classList.remove("isPinned"));
      if (host && !wasPinned) host.classList.add("isPinned");
    }
  }, true);

