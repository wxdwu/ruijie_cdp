      // 3) 预算兑现率
      const totalBudget = budgetKeys.reduce((s,b)=> s+(crm[b.k]||0), 0) + (crm.ProductBudget__c||0);
      const realized = crm.totalWonOpportunityAmount || crm.historyWin__c || 0;
      const realizeRate = totalBudget ? Math.round(realized/totalBudget*100) : 0;
      const peerTotalBudget = budgetKeys.reduce((s,b)=> s+peerAvg(p=>p.crm[b.k]), 0) + peerAvg(p=>p.crm.ProductBudget__c);
      const peerRealized = peerAvg(p=>p.crm.totalWonOpportunityAmount) || peerAvg(p=>p.crm.historyWin__c);
      const peerRate = peerTotalBudget ? Math.round(peerRealized/peerTotalBudget*100) : 0;
      const rateCmp = cmpTone(realizeRate, peerRate);

      // 4) AI 文字洞察
      const insights = [];
      const lowestOutput = outputKeys.map(o=>({
        n:o.n, mine:crm[o.k]||0, peer:peerAvg(p=>p.crm[o.k])
      })).filter(x=>x.peer>0).sort((x,y)=> (x.mine-x.peer)-(y.mine-y.peer))[0];
      if (lowestOutput && lowestOutput.mine < lowestOutput.peer){
        const gap = lowestOutput.peer - lowestOutput.mine;
        insights.push(`<div class="hint">⚠ <b>${lowestOutput.n}</b> 当前 <b>${fmtWan(lowestOutput.mine)}</b>，低于同行均值 <b>${fmtWan(lowestOutput.peer)}</b>，缺口约 <b>${fmtWan(gap)}</b>，可作为下一轮专项重点。</div>`);
      }
      const topBudget = budgetKeys.map(b=>({n:b.n, v:crm[b.k]||0})).sort((x,y)=>y.v-x.v)[0];
      if (topBudget && topBudget.v>0) insights.push(`<div class="hint">本客户最大单项预算：<b>${topBudget.n}</b> ${fmtWan(topBudget.v)}，建议方案围绕该场景优先展开。</div>`);
      insights.push(`<div class="hint">预算总盘 <b>${fmtWan(totalBudget)}</b>，近2年成交 <b>${fmtWan(realized)}</b>，兑现率 <b>${realizeRate}%</b>，<span class="badge ${rateCmp.tone}">${rateCmp.txt}</span>（同行 ${peerRate}%）。</div>`);
      const ratio = totalBudget ? Math.round((crm.sumMoneyInFunnel__c||0)/totalBudget*100) : 0;
      insights.push(`<div class="hint">漏斗内金额覆盖预算 <b>${ratio}%</b>，${ratio<30?"<b>覆盖偏低</b>，潜在商机挖掘不足":(ratio>80?"覆盖充分":"覆盖适中")}。</div>`);

      $("c360TabContent").innerHTML = `
        <div class="grid2">
          <div class="panel" style="box-shadow:none;">
            <div class="panelHeader"><div class="panelMeta"><b>预算结构对位</b><span class="panelTag">Budget Mix</span></div><span class="panelSub">五大场景预算 vs 同行</span>${srcCRM}</div>
            <div class="panelBody"><div class="chartCard">${renderAiChart(budgetRadar)}</div></div>
          </div>
          <div class="panel" style="box-shadow:none;">
            <div class="panelHeader"><div class="panelMeta"><b>预算兑现率</b><span class="panelTag">Realize Rate</span></div><span class="panelSub">近2年成交 / 预算总盘</span>${srcCRM}</div>
            <div class="panelBody"><div class="chartCard">
              <div style="display:flex; align-items:baseline; gap:12px;">
                <div style="font-size:28px; font-weight:900; color:var(--text);">${realizeRate}%</div>
                <span class="badge ${rateCmp.tone}">${rateCmp.txt}</span>
                <div class="hint">同行均值 ${peerRate}%</div>
              </div>
              <div style="margin-top:8px;" class="hint">预算总盘 ${fmtWan(totalBudget)} ｜ 已实现 ${fmtWan(realized)} ｜ 当年漏斗 ${fmtWan(crm.sumMoneyInFunnel__c||0)}</div>
              <div style="margin-top:10px">${kvLine("ProductBudget__c", crm.ProductBudget__c)}${kvLine("historyWin__c", crm.historyWin__c)}</div>
            </div></div>
          </div>
        </div>
        <div class="panel" style="box-shadow:none; margin-top:12px;">
          <div class="panelHeader"><div class="panelMeta"><b>当年产出 · 找空间</b><span class="panelTag">Output vs Peers</span></div><span class="panelSub">无线 / 路由 / 安全 当年产出 vs 同行均值</span>${srcCRM}</div>
          <div class="panelBody"><div class="chartCard">${renderAiChart(outputChart)}</div></div>
        </div>
        <div class="panel" style="box-shadow:none; margin-top:12px;">
          <div class="panelHeader"><div class="panelMeta"><b>AI 预算洞察</b><span class="panelTag">Insight</span></div><span class="panelSub">差距/重点/兑现率综合判定</span>${srcAi}</div>
          <div class="panelBody"><div class="chartCard">${insights.join("")}</div></div>
        </div>
      `;
      return;
    }

    if (state.c360Tab==="risk"){
      // 1) 风险点评分（高/中/低/无）
      const items = [];
      const pushRisk = (level, title, detail, action)=>{
        items.push({level, title, detail, action});
      };
      if (crm.approvalStatus && crm.approvalStatus !== "已通过") pushRisk("中", "审批未通过", `状态：${crm.approvalStatus}`, "推动审批补齐资料");
      if (crm.lockStatus === "已锁定" || /锁定/.test(String(crm.lockStatus||""))) pushRisk("高", "客户已锁定", `${crm.lockStatus}`, "联系运营解锁或转交锁定方");
      if (crm.doNotDisturb === "是" || crm.doNotDisturb === true) pushRisk("高", "客户免打扰", "DoNotDisturb=是", "暂停外呼/邮件触达，转线下");
      if (crm.departmentalRiskWarning__c && crm.departmentalRiskWarning__c !== "无") pushRisk("高", "部门风险预警", crm.departmentalRiskWarning__c, "上报合规并联合方案部门会诊");
      if (["中","高"].includes(crm.sanctionRiskWarning__c)) pushRisk(crm.sanctionRiskWarning__c==="高"?"高":"中", "制裁/出口风险", `等级：${crm.sanctionRiskWarning__c}`, "走法务/合规预审，禁用受限品类");
      if (crm.duplicateFlg === "是" || crm.duplicateFlg === true) pushRisk("低", "客户重复登记", "duplicateFlg=是", "在 CRM 合并主档");
      if (crm.highSeaStatus && /公海/.test(String(crm.highSeaStatus))) pushRisk("中", "公海客户", `${crm.highSeaStatus}`, "认领或加快推进，避免回收");
      if (crm.KHSP__c && /未审核|未通过|失败/.test(String(crm.KHSP__c))) pushRisk("低", "客户审批问题", crm.KHSP__c, "完成审批流程");

      // peer risk count
      const myRisks = items.length;
      const highRisks = items.filter(x=>x.level==="高").length;
      const peerRiskAvg = peers.length ? Math.round(peers.reduce((s,p)=>{
        let n=0;
