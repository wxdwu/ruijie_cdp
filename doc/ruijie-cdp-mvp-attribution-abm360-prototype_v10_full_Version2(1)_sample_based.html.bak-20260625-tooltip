    }));

    const personaOrder = ["拍板者", "决策者", "评估者", "技术把关者", "采购推动者"];
    const personaMax = Math.max(...personaOrder.map(role=> scope.contacts.filter(c=> c.roleTag===role).length), 1);
    renderBars($("roleCoverageChart"), personaOrder.map(role=>{
      const count = scope.contacts.filter(c=> c.roleTag===role).length;
      return {name: role, value: count/personaMax, label: `${count}人`};
    }));

    const tagCounter = new Map();
    scope.accs.forEach((acc)=>{
      [acc.businessScenario, acc.demandType, ...acc.painPoints.slice(0,2)].forEach((tag)=>{
        tagCounter.set(tag, (tagCounter.get(tag)||0) + 1);
      });
    });
    const topTags = Array.from(tagCounter.entries()).sort((a,b)=> b[1]-a[1]).slice(0,6);
    const tagMax = Math.max(...topTags.map(item=> item[1]), 1);
    renderBars($("tagSignalChart"), topTags.map(([name, count])=>({name, value: count/tagMax, label: `${count}家`})));
