  function summarizeLostReasons(oppAll){
    const lostOpps = oppAll.filter((opp)=> (opp.cancel_or_lost || opp.stage === "流失"));
    const reasonCount = {};
    lostOpps.forEach((opp)=>{
      const reason = (opp.lost_reason || opp.blocker_reason || "其他原因").trim();
      reasonCount[reason] = (reasonCount[reason] || 0) + 1;
    });
    const topReasons = Object.entries(reasonCount)
      .sort((a,b)=> b[1] - a[1])
      .slice(0,3)
      .map(([reason, count])=> `${reason}(${count})`);
    return {
      lostCount: lostOpps.length,
      topReasons,
      rawReasons: lostOpps.map((opp)=> opp.lost_reason || opp.blocker_reason).filter(Boolean)
    };
  }

