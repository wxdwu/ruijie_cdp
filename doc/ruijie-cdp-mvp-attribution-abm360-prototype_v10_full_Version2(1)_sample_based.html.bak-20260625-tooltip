  function normalizeFieldMeta(key){
    const meta = FIELD_SOURCES[key];
    if (!meta) return {type:"calc", meaning:key || "字段", from:"样例数据聚合", columns:"-", rule:"字段来自样例数据或聚合结果。", empty:"无数据时显示 -。"};
    if (typeof meta === "string") {
      const parts = {};
      String(meta).split(/[；;]/).map(x=>x.trim()).filter(Boolean).forEach(part=>{
        const idx = Math.max(part.indexOf("："), part.indexOf(":"));
        if (idx > 0) parts[part.slice(0, idx).trim()] = part.slice(idx + 1).trim();
      });
      return {type:"calc", meaning:key, from:parts["来源表"] || parts["来源"] || meta, columns:parts["字段"] || "-", rule:parts["计算"] || parts["规则"] || meta, empty:parts["空值"] || parts["空值处理"] || "无数据时显示 -。"};
    }
    return {
      type: meta.type || "calc",
      meaning: meta.meaning || key,
      from: meta.from || meta.sourceTables || "-",
      columns: meta.columns || meta.sourceColumns || "-",
      rule: meta.rule || meta.calculation || "-",
      timeRule: meta.timeRule || "",
      prompt: meta.prompt || "",
      empty: meta.empty || meta.emptyState || "无数据时显示 -。"
    };
  }

  function fieldPanelContent(key, title){
    const meta = normalizeFieldMeta(key);
    const tag = meta.type === "src" ? `<span class="srcTag src">源字段</span>` : `<span class="srcTag calc">计算</span>`;
    const rows = [
      ["含义", meta.meaning],
      ["来源表", meta.from],
      ["来源字段", meta.columns],
      ["计算逻辑", meta.rule],
      meta.timeRule ? ["时间口径", meta.timeRule] : null,
      meta.prompt ? ["Prompt", meta.prompt] : null,
      ["空值处理", meta.empty]
    ].filter(Boolean).map(([k,v])=>`<div class="sourceHelpRow"><span>${escapeHtml(k)}</span><b>${escapeHtml(v || "-")}</b></div>`).join("");
    return `${tag}<b>${escapeHtml(title || key)}</b><div class="sourceHelpGrid">${rows}</div>`;
  }

  formatSourceHelp = function(text){
    if (text && typeof text === "object") {
      const key = text.meaning || text.label || "字段口径";
      return `<div class="sourceHelpGrid">${fieldPanelContent(key, key)}</div>`;
    }
    const raw = String(text || "");
    const parts = raw.split(/[；;]/).map(x=>x.trim()).filter(Boolean);
    if (!parts.length) return `<div class="sourceHelpText">${escapeHtml(raw || "字段来自样例数据聚合。")}</div>`;
    return `<div class="sourceHelpGrid">${parts.map(part=>{
      const idx = Math.max(part.indexOf("："), part.indexOf(":"));
      if (idx <= 0) return `<div class="sourceHelpText">${escapeHtml(part)}</div>`;
      const key = part.slice(0, idx).trim();
      const val = part.slice(idx + 1).trim();
      return `<div class="sourceHelpRow"><span>${escapeHtml(key)}</span><b>${escapeHtml(val || "-")}</b></div>`;
    }).join("")}</div>`;
  };

  sourceTip = function(key){
    return `<span class="sourceHelp" tabindex="0"><button type="button" class="sourceHelpTrigger" aria-label="查看${escapeHtml(key)}字段口径" title="查看字段口径">?</button><span class="sourceHelpCard" role="tooltip"><span class="sourceHelpKicker">字段口径</span>${fieldPanelContent(key, key)}</span></span>`;
  };

  cardSrcTip = function(title, keys, opts){
    const safe = (keys || []).filter((k)=> FIELD_SOURCES[k]);
    if (!safe.length && !(opts && opts.caveat)) return "";
    const rows = safe.map((k)=>`<div class="srcRow">${fieldPanelContent(k, k)}</div>`).join("");
    const caveat = (opts && opts.caveat) ? `<div class="srcCaveat">${escapeHtml(opts.caveat)}</div>` : "";
    return `<span class="srcTip" data-src-key="${escapeHtml(title || "")}"><span class="srcBtn" role="button" tabindex="0" title="点击查看本卡片字段来源">?</span><span class="srcTipPanel">${title ? `<div class="srcTitle">${escapeHtml(title)} · 字段来源</div>` : ""}${rows}${caveat}</span></span>`;
  };

  function placeSourceHelpCard(host){
    const card = host?.querySelector?.(".sourceHelpCard");
    const btn = host?.querySelector?.(".sourceHelpTrigger");
    if (!card || !btn) return;
    const r = btn.getBoundingClientRect();
    const vw = window.innerWidth, vh = window.innerHeight;
    const margin = 10;
    const w = Math.min(card.offsetWidth || 430, vw - margin * 2);
    card.style.maxHeight = `${vh - margin * 2}px`;
    let h = card.offsetHeight || 220;
    if (h > vh - margin * 2) h = vh - margin * 2;
    let left = r.left + r.width / 2 - w / 2;
    left = Math.max(margin, Math.min(vw - w - margin, left));
    let top = r.bottom + margin;
    if (top + h > vh - margin) top = Math.max(margin, r.top - h - margin);
    card.style.left = `${left}px`;
    card.style.top = `${top}px`;
  }
