    if (state.c360Tab==="opps"){
      const stageOrder = {"成交":7,"谈判":6,"投标":5,"方案":4,"SQL":3,"MQL":2,"流失":1};
      const top = oppAll.slice().sort((a,b)=> (stageOrder[b.stage]||0)-(stageOrder[a.stage]||0) || (b.amount-a.amount));

      // 1) 丢单原因 · 按业务维度归类（预算/价格/竞对/关键人/渠道/流废标）
      const myLost = oppAll.filter(o=> o.lost_reason);
      const peerLost = peerOpps.filter(o=> o.lost_reason);
      const categorize = (arr)=>{
        const m = new Map();
        LOST_REASON_CATEGORIES.forEach(c=> m.set(c.key, {count:0, amount:0, raw:[]}));
        m.set("其他", {count:0, amount:0, raw:[]});
        arr.forEach(o=>{
          const cat = categorizeLostReason(o.lost_reason) || "其他";
          const cur = m.get(cat) || {count:0, amount:0, raw:[]};
          cur.count += 1;
          cur.amount += Math.round((o.amount||0)/10000);
          cur.raw.push(o.lost_reason);
          m.set(cat, cur);
        });
        return m;
      };
      const myCat = categorize(myLost);
      const peerCat = categorize(peerLost);
      const peerN = Math.max(1, peers.length);

      // 双维度对比图：条数 vs 同行均值
      const lossItems = LOST_REASON_CATEGORIES.map(c=>{
        const mine = myCat.get(c.key)?.count || 0;
        const peerAvgCnt = Math.round((peerCat.get(c.key)?.count || 0)/peerN*10)/10;
        return {key:c.key, color:c.color, action:c.action, mine, peer:peerAvgCnt, mineAmt: myCat.get(c.key)?.amount||0};
      });
      const maxLoss = Math.max(1, ...lossItems.map(x=> Math.max(x.mine, x.peer)));

      // 紧凑对比表：一行一个维度，本客户 / 同行均值 共享 X 轴
      const lossRows = lossItems.map(it=>{
        const myW = Math.round(it.mine/maxLoss*100);
        const peerW = Math.round(it.peer/maxLoss*100);
        const isHot = it.mine > it.peer && it.mine > 0;
        const isCool = it.mine === 0 && it.peer >= 0.3;
        const tag = isHot
          ? `<span class="badge bad" style="font-size:10px; padding:1px 6px;">偏高</span>`
          : (isCool ? `<span class="badge ok" style="font-size:10px; padding:1px 6px;">未发生</span>` : `<span class="hint" style="font-size:10.5px;">—</span>`);
        const rowBg = isHot ? "background:rgba(255,138,138,.05);" : "";
        const action = isHot ? `<div class="hint" style="grid-column:1/-1; margin-top:4px; padding-left:18px; color:#7ee0c8; font-size:10.5px;">→ ${escapeHtml(it.action)}</div>` : "";
        return `
          <div style="display:grid; grid-template-columns: 110px 1fr 1fr 70px 56px; gap:10px; align-items:center; padding:7px 10px; border-bottom:1px solid rgba(159,176,208,.10); font-size:11px; ${rowBg}">
