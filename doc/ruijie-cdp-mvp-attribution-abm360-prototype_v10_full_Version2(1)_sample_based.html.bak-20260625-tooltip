  function sendAiChatMessage(query){
    const text = (query || "").trim();
    if (!text) return;
    state.aiChatMessages.push(makeChatMessage("user", {text}));
    state.aiChatMessages.push(makeChatMessage("typing", {}));
    syncAiGuideVisibility();
    renderAiChatMessages();
    const response = buildAiResponse(text);
    setTimeout(()=>{
      state.aiChatMessages = state.aiChatMessages.filter(msg=> msg.role !== "typing");
      state.aiChatMessages.push(makeChatMessage("assistant", response));
      syncAiGuideVisibility();
      renderAiChatMessages();
      renderAiChatSuggestions(response.suggestions || getAiExamples().slice(0,3));
    }, 420);
  }

