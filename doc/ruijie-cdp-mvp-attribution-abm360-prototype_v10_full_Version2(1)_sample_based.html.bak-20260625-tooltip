  // 卡片级"?"：把多个字段说明聚合到一个 ? 弹层中（每张卡只保留一个 ?）
  function cardSrcTip(title, keys, opts){
    const safe = (keys || []).filter((k)=> FIELD_SOURCES[k]);
    if (!safe.length && !(opts && opts.caveat)) return "";
    const rows = safe.map((k)=>{
      const meta = FIELD_SOURCES[k];
      const tag = meta.type === "src"
        ? `<span class="srcTag src">源字段</span>`
        : `<span class="srcTag calc">计算</span>`;
      const rule = meta.rule ? `<div class="srcRule">规则：${escapeHtml(meta.rule)}</div>` : "";
      return `<div class="srcRow">${tag}<b>${escapeHtml(k)}</b><div class="srcFrom">来源：${escapeHtml(meta.from)}</div>${rule}</div>`;
    }).join("");
    const caveat = (opts && opts.caveat) ? `<div class="srcCaveat">${escapeHtml(opts.caveat)}</div>` : "";
    return `<span class="srcTip" data-src-key="${escapeHtml(title || "")}"
      ><span class="srcBtn" role="button" tabindex="0" title="点击查看本卡片字段来源">?</span
      ><span class="srcTipPanel">${title ? `<div class="srcTitle">${escapeHtml(title)} · 字段来源</div>` : ""}${rows}${caveat}</span
    ></span>`;
  }

  // 全局：基于 click 切换 .srcTip 的 .is-open，并把 fixed 弹层定位到 summary 旁
  function placeSrcTipPanel(tip){
    const panel = tip.querySelector(":scope > .srcTipPanel");
    const btn = tip.querySelector(":scope > .srcBtn");
    if (!panel || !btn) return;
    // 先清空旧约束，避免上一次的 maxHeight/overflow 影响测量
    panel.style.maxHeight = "";
    panel.style.overflowY = "";
    const r = btn.getBoundingClientRect();
    const vw = window.innerWidth, vh = window.innerHeight;
    const margin = 8;
    const W = Math.min(panel.offsetWidth || 340, vw - 2*margin);
    let H = panel.offsetHeight || 160;
    // 若内容比视口还高，则允许内部滚动并夹紧高度
    const maxH = vh - 2*margin;
    if (H > maxH) {
      panel.style.maxHeight = maxH + "px";
      panel.style.overflowY = "auto";
      H = maxH;
    }
    // 横向：以按钮为中心，超出则贴边
    let left = r.left + r.width/2 - W/2;
    if (left + W > vw - margin) left = vw - W - margin;
    if (left < margin) left = margin;
    // 纵向：优先下方，其次上方，否则在视口内夹紧
    const spaceBelow = vh - r.bottom - margin;
    const spaceAbove = r.top - margin;
    let top;
    if (spaceBelow >= H) top = r.bottom + margin;
    else if (spaceAbove >= H) top = r.top - H - margin;
    else top = Math.max(margin, Math.min(vh - H - margin, r.top));
    // 防御性夹紧：保证 panel 始终落在视口内
    if (top < margin) top = margin;
    if (top + H > vh - margin) top = Math.max(margin, vh - H - margin);
    panel.style.left = left + "px";
    panel.style.top = top + "px";
  }
