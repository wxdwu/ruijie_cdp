  function refreshAiExperimentSummary(exp){
    const betterVariant = exp.metrics.lift >= 10 ? "B" : "A";
    exp.insight = `AI 判断版本${betterVariant}在“${exp.name.replace("AI试验-", "") || "当前试验"}”中表现更优，当前增益 ${exp.metrics.lift}% ，建议继续沿优势版本放量。`;
    exp.feedback = exp.metrics.sqlGain >= 5
      ? "反馈显示当前试验已出现稳定 SQL 增益，建议扩大高响应客群占比。"
      : "反馈显示当前试验仍需积累更多高价值行为，建议优化内容主题与触达节奏。";
  }

  function appendAiProcessLog(exp, step, detail, status){
    const stamp = `${toYMD(TODAY)} ${String(9 + (exp.processLog.length%8)).padStart(2,"0")}:${String((exp.processLog.length*7)%60).padStart(2,"0")}`;
    exp.processLog.unshift({step, detail, status: status || "done", at: stamp});
    exp.processLog = exp.processLog.slice(0, 10);
  }

  function runAiExperimentStep(step, segmentId){
    const exp = getAiExperiment();
    if (!exp) return;
    const aiLab = db.aiLab;
    const segMap = new Map(aiLab.segments.map(s=>[s.segment_id, s]));
    const currentSeg = segMap.get(exp.segment_id);
    if (step === "all"){
      exp.status = "运行中";
      exp.metrics.sent += 22;
      exp.metrics.open += 8;
      exp.metrics.click += 5;
      exp.metrics.mqlGain += 2;
      exp.metrics.sqlGain += 1;
      exp.metrics.lift = Math.min(22, exp.metrics.lift + 3);
      exp.processLog = [
        {step:"全流程试验", status:"running", detail:"AI 已串联自动分群、策略生成、A/B Test、洞察和反馈闭环", at:`${toYMD(TODAY)} 09:30`},
        ...exp.processLog
      ].slice(0,10);
      exp.processData.push({date: toYMD(TODAY), exposure: exp.metrics.sent, open: exp.metrics.open, click: exp.metrics.click, feedback: Math.max(3, exp.metrics.sqlGain)});
    }
    if (step === "segment"){
      const targetSeg = segMap.get(segmentId || exp.segment_id) || currentSeg;
      exp.segment_id = targetSeg.segment_id;
      exp.name = `AI试验-${targetSeg.name}`;
      exp.metrics.audience = targetSeg.count;
      exp.metrics.sent = Math.round(targetSeg.count * 0.74);
      appendAiProcessLog(exp, "自动分群", `已切换到“${targetSeg.name}”，识别 ${targetSeg.count} 个目标客户`, "done");
    }
    if (step === "ab"){
      const nextA = exp.traffic.A === 50 ? 60 : 50;
      exp.traffic = {A: nextA, B: 100-nextA};
      exp.metrics.lift = Math.min(25, exp.metrics.lift + 2);
      exp.metrics.click += 3;
      appendAiProcessLog(exp, "A/B Test", `已将流量调整为 ${exp.traffic.A}/${exp.traffic.B}，并重新发起对照试验`, "running");
    }
    if (step === "insight"){
      exp.metrics.open += 2;
      refreshAiExperimentSummary(exp);
      appendAiProcessLog(exp, "洞察生成", "AI 已基于最新过程数据刷新结论与建议", "done");
    }
    if (step === "feedback"){
      exp.metrics.sqlGain += 1;
      exp.metrics.winGain += 1;
      refreshAiExperimentSummary(exp);
      appendAiProcessLog(exp, "反馈写回", "已将最新反馈写回策略建议，并更新下一轮实验动作", "done");
    }
    refreshAiExperimentSummary(exp);
    renderAiLab();
    showToast(step === "all" ? "已发起全流程 AI 试验" : "AI 步骤已更新");
  }

