      },0)/peers.length) : 0;
      const radarMax = Math.max(100, peerVisit, myVisit, peerEffective, myEffective)*1.1;
      const norm = (v, max)=> Math.min(100, Math.round((v/Math.max(1,max))*100));
      const radarChart = {
