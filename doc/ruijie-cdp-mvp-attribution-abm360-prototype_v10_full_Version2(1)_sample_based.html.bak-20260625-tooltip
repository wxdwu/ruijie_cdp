  function detectRoleGaps(contacts){
    const roleTags = new Set(contacts.map(c=> c.roleTag));
    const requirements = [
      {role:"拍板者", chain:"决策链"},
      {role:"决策者", chain:"决策链"},
      {role:"评估者", chain:"技术评估链"},
      {role:"采购推动者", chain:"采购链"}
    ];
    return requirements.filter(item=> !roleTags.has(item.role));
  }

  function makeOrgChains(contacts){
    const byScore = contacts.slice().sort((a,b)=> (b.crm.contactScore - a.crm.contactScore));
    const decision = [];
    const evaluation = [];
    const procurement = [];
    const isDecision = (c)=> c.chainType === "决策链";
    const isEvaluation = (c)=> c.chainType === "技术评估链" || c.roleTag === "技术把关者";
    const isProc = (c)=> c.chainType === "采购链";
    byScore.forEach(c=>{ if (decision.length<4 && isDecision(c)) decision.push(c); });
    byScore.forEach(c=>{ if (evaluation.length<4 && isEvaluation(c)) evaluation.push(c); });
    byScore.forEach(c=>{ if (procurement.length<4 && isProc(c)) procurement.push(c); });
    const used = new Set([...decision,...evaluation,...procurement].map(x=>x.contact_id));
    for (const c of byScore){
      if (decision.length<4 && !used.has(c.contact_id)){ decision.push(c); used.add(c.contact_id); }
      if (evaluation.length<4 && !used.has(c.contact_id)){ evaluation.push(c); used.add(c.contact_id); }
      if (procurement.length<4 && !used.has(c.contact_id)){ procurement.push(c); used.add(c.contact_id); }
      if (decision.length>=4 && evaluation.length>=4 && procurement.length>=4) break;
    }
    return [
      {key:"decision", title:"决策链", nodes: decision},
      {key:"evaluation", title:"技术评估链", nodes: evaluation},
      {key:"proc", title:"采购链", nodes: procurement},
    ];
  }

  // SVG links drawing
  function drawOrgLinks(containerId, svgId, contacts){
    const container = document.getElementById(containerId);
    const svg = document.getElementById(svgId);
    if(!container || !svg) return;

    const rectC = container.getBoundingClientRect();
    const getAnchor = (el, which)=>{
      const r = el.getBoundingClientRect();
      const x0 = r.left - rectC.left;
      const y0 = r.top - rectC.top;
      const x = x0 + r.width/2;
      const y = (which==="top") ? (y0 + 6) : (y0 + r.height - 6);
      return {x, y};
    };

    const elMap = new Map();
    container.querySelectorAll("[data-contact]").forEach(el=> elMap.set(el.dataset.contact, el));

    const lines = [];
    for (const c of contacts){
      if(!c.reportsToId) continue;
      const fromEl = elMap.get(c.reportsToId);
      const toEl = elMap.get(c.contact_id);
      if(!fromEl || !toEl) continue;

      const p1 = getAnchor(fromEl, "bottom");
      const p2 = getAnchor(toEl, "top");
      const dx = Math.abs(p2.x - p1.x);
      const bend = clamp(dx*0.35, 40, 160);
      const c1 = {x: p1.x, y: p1.y + bend};
      const c2 = {x: p2.x, y: p2.y - bend};
      const d = `M ${p1.x} ${p1.y} C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${p2.x} ${p2.y}`;
      const midX = (p1.x+p2.x)/2;
      const midY = (p1.y+p2.y)/2;
      lines.push({d, label: c.relationType, x: midX, y: midY});
    }

    const stroke = "rgba(159,176,208,.35)";
    const text = "rgba(159,176,208,.78)";
    svg.setAttribute("viewBox", `0 0 ${Math.max(100, rectC.width)} ${Math.max(100, rectC.height)}`);
    svg.innerHTML = `
      <defs>
        <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L9,3 L0,6 Z" fill="rgba(159,176,208,.55)"></path>
        </marker>
      </defs>
      ${lines.map(l=>`
        <path d="${l.d}" fill="none" stroke="${stroke}" stroke-width="2" marker-end="url(#arrow)"></path>
        <rect x="${l.x-22}" y="${l.y-18}" rx="7" ry="7" width="44" height="18" fill="rgba(0,0,0,.22)" stroke="rgba(159,176,208,.18)"></rect>
        <text x="${l.x}" y="${l.y-5}" text-anchor="middle" fill="${text}" font-size="11">${escapeHtml(l.label)}</text>
      `).join("")}
    `;
  }
  function scheduleDrawOrgLinks(conAll){
    const container = $("orgBody");
    const svg = $("orgSvg");
    if (!container || !svg) return;
    const doDraw = ()=>{ try { drawOrgLinks("orgBody", "orgSvg", conAll); } catch(e) {} };
    requestAnimationFrame(()=> requestAnimationFrame(doDraw));
    if (!container.dataset.bound){
      container.dataset.bound = "1";
      let t = null;
      const throttled = ()=>{
        if (t) return;
        t = setTimeout(()=>{ t=null; doDraw(); }, 120);
      };
      container.addEventListener("scroll", throttled, {passive:true});
      window.addEventListener("resize", throttled);
    }
  }

