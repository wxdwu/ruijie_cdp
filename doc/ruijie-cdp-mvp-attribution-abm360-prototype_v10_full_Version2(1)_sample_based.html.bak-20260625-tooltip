  // Cockpit
  function calcHotnessForAccount(accId){
    const weights = {
      "曝光": 1, "触达": 2, "点击": 3, "内容打开": 4, "内容点击": 6,
      "留资": 10, "咨询": 8, "报名": 8, "MQL": 12, "SQL": 18, "商机": 25, "成交": 50
    };
    const start = toYMD(addDays(TODAY, -7));
    const end = toYMD(TODAY);
    const evs = db.interactions.filter(e=> e.account_id===accId && dateInRange(e.date, start, end));
    const eventScore = evs.reduce((s,e)=> s + (weights[e.type] || 0), 0);
    const byType = new Map();
    evs.forEach((e)=> byType.set(e.type, (byType.get(e.type)||0) + 1));

    const acc = db.accounts.find(a=>a.account_id===accId);
    const intent = acc ? acc.intent_score : 0;
    const stageBoost = ()=>{
      const st = acc?.pipelineStage || "";
      if (st==="成交") return 40;
      if (["谈判","投标","方案"].includes(st)) return 20;
      if (st==="SQL") return 10;
      return 0;
    };
    const stageScore = stageBoost();
    const hot = Math.round(eventScore + intent*0.6 + stageScore);
    const topEvent = Array.from(byType.entries()).sort((a,b)=> b[1]-a[1])[0]?.[0] || "无显著互动";
    return {hot, evCount: evs.length, eventScore, intentScore: Math.round(intent*0.6), stageScore, topEvent};
  }

