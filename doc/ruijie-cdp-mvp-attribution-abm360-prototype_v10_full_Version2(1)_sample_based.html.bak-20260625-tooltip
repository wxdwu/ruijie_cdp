  renderCampaignSignals = function(campaignId){
    const scope = filteredCampaignScope(campaignId);
    const stageCounter = new Map();
    scope.accs.forEach(a=> stageCounter.set(a.stage || "未知", (stageCounter.get(a.stage || "未知")||0)+1));
    const stageRows = Array.from(stageCounter.entries()).sort((a,b)=>b[1]-a[1]);
    const stageMax = Math.max(...stageRows.map(x=>x[1]), 1);
    renderBars($("stageDistChart"), stageRows.map(([name,count])=>({name, value:count/stageMax, label:`${count}家`})));

    const roleCounter = new Map([["0/4",0],["1/4",0],["2/4",0],["3/4",0],["4/4",0]]);
    scope.accs.forEach(a=>{
      const cov = getCoverageStatus(a.account_id);
      roleCounter.set(cov.score, (roleCounter.get(cov.score)||0)+1);
    });
    const roleRows = Array.from(roleCounter.entries()).filter(([,count])=>count>0);
    const roleMax = Math.max(...roleRows.map(x=>x[1]), 1);
    renderBars($("roleCoverageChart"), roleRows.map(([name,count])=>({name, value:count/roleMax, label:`${count}家`})));

    const signalCounter = new Map();
    scope.accs.forEach(a=>{
      [
        ...(a.historyProductLines || []),
        ...(a.painPoints || []),
        a.industry,
        ...(a.tags || [])
      ].forEach(t=> String(t || "").split(/[\/、,，\s]+/).filter(Boolean).slice(0,4).forEach(x=>{
        if (x && x !== "未知" && !/^H$|^M$|^L$/.test(x)) signalCounter.set(x,(signalCounter.get(x)||0)+1);
      }));
    });
    const signalRows = Array.from(signalCounter.entries()).sort((a,b)=>b[1]-a[1]).slice(0,6);
    const signalMax = Math.max(...signalRows.map(x=>x[1]), 1);
    renderBars($("tagSignalChart"), signalRows.map(([name,count])=>({name, value:count/signalMax, label:`${count}次`})));
  };

