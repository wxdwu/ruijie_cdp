              ]
            },
            right: {
              title: "联系人 B",
              name: rightContact?.name || `${account.name}_线索联系人`,
              fields: [
                {label:"所属客户", value:idx % 2 === 0 ? account.name : altAccount.name},
                {label:"角色标签", value:rightContact?.roleTag || "采购推动者"},
                {label:"手机号", value:rightContact?.phone || leftContact?.phone || "-"},
                {label:"邮箱", value:rightContact?.email || `${(rightContact?.name || "lead").toLowerCase()}@demo.com`},
                {label:"近30天行为", value:rightContact?.activityLevel || "高"}
              ]
            },
            evidence: [
              `专项：${account.specialName}；客户场景 ${account.businessScenario}`,
              `手机号脱敏后一致，角色分别为 ${leftContact?.roleTag || "-"} / ${rightContact?.roleTag || "-"}`,
              `一个来源于 CRM 存量联系人，一个来源于活动报名或企微新增线索`
            ]
          };
        }
      },
      {
        type: "订单归属冲突",
        matchedThrough: "订单号相似 + 产品线重叠 + 开票抬头模糊命中",
        queueReason: "同一订单线索可能被归到两个客户主体，需要确认最终归属，避免影响专项归因和成交统计。",
        sourceSystems: ["订单合同表", "CRM客户表", "营销归因宽表"],
        approveLabel: "确认归属调整",
        rejectLabel: "维持当前归属",
        approveResult: "已确认订单归属调整，成交金额与归因链路将重算至目标主体。",
        rejectResult: "已确认维持当前归属，保留现有订单统计口径。",
        build(account, idx){
          const altAccount = accounts.find(a=> a.account_id!==account.account_id && a.special===account.special) || accounts.find(a=> a.account_id!==account.account_id) || account;
          const topOpp = opps.find(o=> o.account_id===account.account_id) || {opp_id:`ORD_${7800+idx}`, amount:320000, stage:account.pipelineStage};
          return {
            subject: `${topOpp.opp_id} ⇄ ${account.name} / ${altAccount.name}`,
            left: {
              title: "订单归属候选 A",
              name: account.name,
              fields: [
                {label:"订单号", value:topOpp.opp_id},
                {label:"订单金额", value:`¥${Math.round(topOpp.amount/10000)}万`},
                {label:"产品线", value:account.historyProductLines.join(" / ")},
                {label:"负责人", value:account.owner},
                {label:"当前阶段", value:account.pipelineStage}
              ]
            },
            right: {
              title: "订单归属候选 B",
              name: altAccount.name,
              fields: [
                {label:"订单号", value:`${topOpp.opp_id}-ALT`},
                {label:"订单金额", value:`¥${Math.round(topOpp.amount/10000)}万`},
                {label:"产品线", value:altAccount.historyProductLines.join(" / ")},
                {label:"负责人", value:altAccount.owner},
                {label:"当前阶段", value:altAccount.pipelineStage}
              ]
            },
            evidence: [
              `专项：${account.specialName}；原归因客户 ${account.name}，候选归属客户 ${altAccount.name}`,
              `订单金额与产品线一致，但开票抬头在历史合同里出现了两种映射`,
              `若归属切换，将影响 ${account.special} 专项成交归因与负责人业绩口径`
            ]
          };
        }
      },
      {
        type: "OneID 冲突",
        matchedThrough: "OneID 主键候选重叠 + 主体图谱冲突",
        queueReason: "同一 OneID 被多个主体候选占用，且来源系统主键不一致，需要人工指定最终主映射。",
        sourceSystems: ["OneID主表", "CRM客户表", "官网埋点", "活动报名表"],
        approveLabel: "确认 OneID 主映射",
        rejectLabel: "拆分 OneID",
        approveResult: "已确认 OneID 主映射，后续行为、订单与联系人均归并到统一身份下。",
        rejectResult: "已拆分 OneID，避免跨主体污染画像与归因。",
        build(account, idx, contactsForAccount){
          const candidateA = `ONE_${9300+idx}`;
          const candidateB = `ONE_${9300+idx}_${idx % 2 === 0 ? "A" : "B"}`;
          return {
            subject: `${candidateA} ⇄ ${candidateB}`,
            left: {
              title: "OneID 候选 A",
              name: candidateA,
              fields: [
                {label:"主体名称", value:account.name},
                {label:"来源系统", value:"CRM客户表 / 官网埋点"},
                {label:"关键标识", value:account.crm.UniformSocialCreditCode__c},
                {label:"关键联系人", value:contactsForAccount[0]?.name || "-"},
                {label:"最近活动", value:account.pipelineStage}
              ]
            },
            right: {
              title: "OneID 候选 B",
              name: candidateB,
              fields: [
                {label:"主体名称", value:`${account.name.replace(/_\d+$/, "")}_渠道线索`},
                {label:"来源系统", value:"活动报名表 / 智趣百川"},
                {label:"关键标识", value:idx % 2 === 0 ? account.crm.UniformSocialCreditCode__c : "手机号脱敏 + 邮箱前缀"},
                {label:"关键联系人", value:contactsForAccount[1]?.name || contactsForAccount[0]?.name || "-"},
                {label:"最近活动", value:pick(["内容下载","直播报名","咨询留资"])}
              ]
            },
            evidence: [
              `专项：${account.specialName}；客户等级 ${account.customerTier}；意向分 ${account.intent_score}`,
              `同一身份图谱下同时挂接客户、联系人与活动留资三类对象，主键冲突需要人工定版`,
              `若不处理，将影响 360 页面互动累计与专项归因的唯一身份口径`
            ]
          };
        }
      }
    ];
    const pendingAccounts = accounts.slice().sort((a,b)=> b.intent_score-a.intent_score).slice(0,12);
    pendingAccounts.forEach((account, idx)=>{
      const blueprint = reviewTypeBlueprints[idx % reviewTypeBlueprints.length];
      const confidence = 0.71 + (idx % 5) * 0.03;
      const contactsForAccount = contacts.filter(c=> c.account_id===account.account_id).slice(0,3);
      const detail = blueprint.build(account, idx, contactsForAccount);
      reviewQueue.push({
        review_id: `RVW_${6000+idx}`,
        type: blueprint.type,
        status: idx >= 9 ? (idx % 2 === 0 ? "已通过" : "已驳回") : "待审核",
        confidence_score: Number(confidence.toFixed(2)),
        matched_through: blueprint.matchedThrough,
        queue_reason: blueprint.queueReason,
        ai_recommendation: confidence >= 0.8
          ? `AI 倾向执行“${blueprint.approveLabel}”，但建议先核对关键标识与业务归属后再回写。`
          : `AI 倾向执行“${blueprint.rejectLabel}”，当前证据尚不足以直接自动处理。`,
        source_systems: blueprint.sourceSystems,
        one_id_candidate: `ONE_${9000+idx}`,
        created_at: toYMD(addDays(TODAY, -(idx+1))),
        related_campaign: account.specialName,
        approve_label: blueprint.approveLabel,
        reject_label: blueprint.rejectLabel,
        approve_result: blueprint.approveResult,
        reject_result: blueprint.rejectResult,
        ...detail
      });
    });
    reviewQueue.forEach((item)=>{
      item.evidence = [
        `审核类型：${item.type}；专项：${item.related_campaign}；匹配方式：${item.matched_through}`,
        ...item.evidence,
        `AI 置信度 ${Math.round(item.confidence_score*100)}%，原因：${item.queue_reason}`
      ];
      if (item.status === "已通过"){
        item.reviewer = "人工审核员";
        item.reviewed_at = `${item.created_at} 16:20`;
        item.audit_result = item.approve_result;
      }
      if (item.status === "已驳回"){
        item.reviewer = "人工审核员";
        item.reviewed_at = `${item.created_at} 17:10`;
        item.audit_result = item.reject_result;
      }
    });

    // assign reportsToId
    const byAcc = new Map();
    contacts.forEach(c=>{
      if(!byAcc.has(c.account_id)) byAcc.set(c.account_id, []);
      byAcc.get(c.account_id).push(c);
    });
    for (const [accId, arr] of byAcc.entries()){
      arr.sort((a,b)=> b.crm.contactScore - a.crm.contactScore);
      const boss = arr[0];
      if (boss){ boss.reportsToId=""; boss.relationType="—"; }
      for (let i=1;i<arr.length;i++){
        const c = arr[i];
        const parent = arr.find(item=> item.chainType===c.chainType && item.contact_id!==c.contact_id) || boss || arr[0];
