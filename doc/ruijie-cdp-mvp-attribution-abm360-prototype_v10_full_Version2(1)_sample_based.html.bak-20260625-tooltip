    $("aiChatInput").focus();
    $("aiChatInput").oninput = ()=>{ state.aiChatDraft = $("aiChatInput").value; };
    $("aiChatInput").onkeydown = (e)=>{
      if (e.key === "Enter" && !e.shiftKey){
        e.preventDefault();
        const q = $("aiChatInput").value;
        $("aiChatInput").value = "";
        state.aiChatDraft = "";
        sendAiChatMessage(q);
      }
    };
    $("btnSendAiChat").onclick = ()=>{
      const q = $("aiChatInput").value;
      $("aiChatInput").value = "";
      state.aiChatDraft = "";
      sendAiChatMessage(q);
    };
    $("aiDrawerOverlay").onclick = (e)=>{
      if (e.target === $("aiDrawerOverlay")){
        closeAiDrawer();
        return;
      }
      const example = e.target.closest("[data-ai-example]");
      if (example){
        const q = example.dataset.aiExample || "";
        sendAiChatMessage(q);
        return;
      }
      const modeBtn = e.target.closest("[data-ai-mode]");
      if (modeBtn){
        state.aiMode = modeBtn.dataset.aiMode || "summary";
        renderAiModeTabs();
        renderAiExamples();
        syncAiGuideVisibility();
        syncAiComposerPlaceholder();
        return;
      }
      const actionBtn = e.target.closest("[data-ai-action]");
      if (actionBtn){
        runAiDrawerAction(actionBtn);
        return;
      }
      const suggest = e.target.closest("[data-ai-suggest]");
      if (suggest){
        const q = suggest.dataset.aiSuggest || "";
        sendAiChatMessage(q);
      }
    };
  }

