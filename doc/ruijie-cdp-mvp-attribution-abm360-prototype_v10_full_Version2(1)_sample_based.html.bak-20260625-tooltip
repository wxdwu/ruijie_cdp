  function genFunnelRealistic(){
    // B2B 营销漏斗采用严格递减生成，曝光到成交整体通常在 0.03%~0.18% 区间。
    const expo = 120000 + Math.floor(R()*180000);
    const nextStage = (prev, minRate, maxRate, floorValue=1)=>{
      if (prev <= 1) return 1;
      const raw = Math.floor(prev * (minRate + R()*(maxRate-minRate)));
      return Math.max(floorValue, Math.min(prev - 1, raw));
    };

    const touch = nextStage(expo, 0.50, 0.68, 1000);
    const click = nextStage(touch, 0.06, 0.12, 180);
    const lead = nextStage(click, 0.10, 0.20, 30);
    const mql = nextStage(lead, 0.35, 0.55, 12);
    const sql = nextStage(mql, 0.45, 0.65, 6);
    const opp = nextStage(sql, 0.22, 0.34, 2);
    const won2 = nextStage(opp, 0.28, 0.46, 1);

    return [
      {k:"曝光", n: expo},
      {k:"触达", n: touch},
      {k:"点击", n: click},
      {k:"留资", n: lead},
      {k:"MQL", n: mql},
      {k:"SQL", n: sql},
      {k:"商机", n: opp},
      {k:"成交", n: won2}
    ];
  }

