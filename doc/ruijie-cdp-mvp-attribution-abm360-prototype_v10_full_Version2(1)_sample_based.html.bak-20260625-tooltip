    $("btnAbmApply").addEventListener("click", renderAbmList);
    $("abmSearch").addEventListener("keydown", (e)=>{ if(e.key==="Enter") renderAbmList(); });
    ["abmCampaign","abmIndustry","abmStage","abmIntentMin","abmOwner","abmInteractMin","abmChannel"].forEach(id=>{
      const el = $(id);
      if (el) el.addEventListener("change", renderAbmList);
    });
    if ($("btnAbmAiFilter")){
      $("btnAbmAiFilter").addEventListener("click", ()=>{
        const entities = getAbmEntitiesFromControls();
        const campaign = db.campaigns.find(c=> c.campaign_id === entities.campaignId);
        const parts = [
          campaign ? campaign.special : "",
          entities.industry ? `${entities.industry}行业` : "",
          entities.stage ? `${entities.stage}阶段` : "",
          entities.owner && entities.owner !== "未知" ? `${entities.owner}负责` : "",
          entities.channel ? `${entities.channel}互动` : "",
          entities.interactionMin ? `互动次数大于${entities.interactionMin}` : "",
          entities.text ? `客户名包含${entities.text}` : ""
        ].filter(Boolean).join("，");
        state.aiChatDraft = parts ? `找${parts}的客户` : "帮我筛选当前 ABM 客户列表";
        openAiDialog();
      });
    }

    $("abmListRows").addEventListener("click", (e)=>{
      const btn = e.target.closest("button[data-open360]");
      if(!btn) return;
      openCustomer360(btn.dataset.open360, "abm");
    });

    $("cockpitHotAccRows").addEventListener("click", (e)=>{
      const btn = e.target.closest("button[data-open360]");
      if(!btn) return;
      openCustomer360(btn.dataset.open360, "cockpit");
    });

    $("btnBack").addEventListener("click", ()=>{
      const prev = state.backStack.pop();
      if(!prev){ setView("campaign"); renderCampaign(); return; }
      setView(prev.view);
      if (prev.view==="campaign") renderCampaign();
      if (prev.view==="aiLab") renderAiLab();
      if (prev.view==="abmList") renderAbmList();
      if (prev.view==="cockpit") renderCockpit();
      if (prev.view==="review") renderReview();
    });

    $("btnCloseModal").addEventListener("click", closeModal);
    $("modalOverlay").addEventListener("click", (e)=>{ if(e.target===$("modalOverlay")) closeModal(); });
    $("btnCloseAiDrawer").addEventListener("click", closeAiDrawer);

    $("btnGenData").addEventListener("click", ()=>{
      genData();
      initFilters();
      renderCampaign();
      renderAiLab();
      renderAbmList();
      renderCockpit();
      renderReview();
      showToast("已生成");
    });

    $("btnOpenData").addEventListener("click", ()=>{
      const a = db.accounts[0];
      const oppCount = db.opps.filter(o=>o.account_id===a.account_id).length;
      openModal("数据", `<pre class="mono" style="margin:0">${escapeHtml(JSON.stringify({
        account_sample: a,
        opp_count_for_sample: oppCount,
        ai_experiment_sample: db.aiLab?.experiments?.[0] || null
      }, null, 2))}</pre>`);
    });

    $("btnExport").addEventListener("click", exportCurrent);
    $("btnAiDialog").addEventListener("click", openAiDialog);

    $("btnTheme").addEventListener("click", ()=>{
      const cur = document.documentElement.getAttribute("data-theme") || "light";
      setTheme(cur==="dark" ? "light" : "dark");
    });

    document.addEventListener("keydown", (e)=>{
      if (e.key === "Escape" && $("aiDrawerOverlay").classList.contains("open")){
        closeAiDrawer();
      }
    });

    document.addEventListener("click", (e)=>{
      const reviewTypeBtn = e.target.closest("[data-review-type]");
      if (reviewTypeBtn){
        state.reviewFilterType = reviewTypeBtn.dataset.reviewType || "全部";
        renderReview();
        return;
      }
      const reviewOpenBtn = e.target.closest("[data-review-open]");
      if (reviewOpenBtn){
        const item = (db.reviewQueue || []).find(entry=> entry.review_id===reviewOpenBtn.dataset.reviewOpen);
        if (item) openReviewDetail(item);
        return;
      }
      const reviewActionBtn = e.target.closest("[data-review-action][data-review-id]");
      if (reviewActionBtn){
        applyReviewDecision(reviewActionBtn.dataset.reviewId, reviewActionBtn.dataset.reviewAction);
        return;
      }
      const aiRunBtn = e.target.closest("[data-ai-run]");
      if (aiRunBtn){
        runAiExperimentStep(aiRunBtn.dataset.aiRun, aiRunBtn.dataset.segmentId || "");
        return;
      }
      const aiActionBtn = e.target.closest("[data-ai-action]");
      if (aiActionBtn?.dataset.aiAction === "process"){
        const exp = getAiExperiment();
        if (exp) openAiProcessModal(exp);
        return;
      }
      const tabBtn = e.target.closest(".tabBtn[data-tab]");
      if(!tabBtn) return;
      if (state.view !== "customer360") return;
      const key = tabBtn.dataset.tab;
      state.c360Tab = key;
      renderC360Tabs();
      const acc = db.accounts.find(x=>x.account_id===state.selectedAccountId);
      if (acc) renderC360TabContent(acc);
    });

    document.addEventListener("change", (e)=>{
      if (e.target?.id === "aiExpSelect"){
        state.selectedAiExperimentId = e.target.value;
        renderAiLab();
      }
    });
  }

  function init(){
    try {
      initTheme();
      bindAuth();
      const session = getAuthSession();
      if(session){
        showApp(session);
      } else {
        showLogin("");
      }
    } catch (err) {
      showBootError(`${err?.message || err}${err?.stack ? `\n${err.stack}` : ""}`);
      throw err;
    }
  }

  window.addEventListener("error", (event)=>{
    const detail = `${event.message || "未知错误"}${event.filename ? `\n${event.filename}:${event.lineno || 0}:${event.colno || 0}` : ""}`;
    showBootError(detail);
  });

  document.addEventListener("DOMContentLoaded", init);
})();
</script>
</body>
</html>
