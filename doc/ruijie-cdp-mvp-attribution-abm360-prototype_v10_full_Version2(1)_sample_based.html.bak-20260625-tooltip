  function filterAccountsByEntities(entities){
    let accs = (db?.accounts || []).slice();
    const q = (entities.text || entities.customer || "").trim().toLowerCase();
    if (q) accs = accs.filter(a=> [a.name,a.industry,a.region,a.owner,a.stage,a.pipelineStage,(a.historyProductLines||[]).join(" "),(a.painPoints||[]).join(" ")].join(" ").toLowerCase().includes(q));
    if (entities.campaignId) accs = accs.filter(a=> (a.campaign_ids || [a.campaign_id]).includes(entities.campaignId));
    if (entities.industry) accs = accs.filter(a=> a.industry===entities.industry);
    if (entities.province) accs = accs.filter(a=> a.region===entities.province || a.province===entities.province);
    if (entities.owner) accs = accs.filter(a=> a.owner===entities.owner);
    if (entities.stage) accs = accs.filter(a=> a.stage===entities.stage || a.pipelineStage===entities.stage);
    if (entities.intentMin != null) accs = accs.filter(a=> a.intent_score >= Number(entities.intentMin || 0));
    if (entities.interactionMin != null) accs = accs.filter(a=> Number(a.contactInteractionCount || 0) >= Number(entities.interactionMin || 0));
    if (entities.hasOpportunity) accs = accs.filter(a=> Number(a.opportunityCount || 0) > 0);
    if (entities.dealCustomer) accs = accs.filter(a=> !!a.dealCustomer);
    if (entities.amountMin != null) accs = accs.filter(a=> Number(a.amountWan || 0) >= Number(entities.amountMin || 0));
    if (entities.channel) accs = accs.filter(a=> (a.channels || []).includes(entities.channel) || (db.interactions || []).some(e=> e.account_id===a.account_id && e.channel===entities.channel));
    return accs.sort((a,b)=> (b.contactInteractionCount-a.contactInteractionCount) || (b.opportunityCount-a.opportunityCount) || (b.amountWan-a.amountWan));
  }

