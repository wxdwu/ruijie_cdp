  renderContentRanking = function(campaignId){
    updateContentHeader();
    const scope = filteredCampaignScope(campaignId);
    const ids = new Set(scope.accs.map(a=>a.account_id));
    const contentById = new Map((db.contents || []).map(c=>[c.content_id, c]));
    const accountById = new Map((db.accounts || []).map(a=>[a.account_id, a]));
    const byContent = new Map();
    scope.evs.filter(e=> ids.has(e.account_id) && (e.content_id || e.note || e.type)).forEach(e=>{
      const content = e.content_id ? contentById.get(e.content_id) : null;
      const key = e.content_id || e.note || e.type;
      const item = byContent.get(key) || {
        title: content?.title || e.note || e.type || "-",
        type: content?.type || e.type || "互动",
        persona: content?.personaFit || "样例未提供",
        contentInterest: content?.contentInterest || content?.topic || e.note || "-",
        productInterest: content?.productInterest || "-",
        accounts:new Set(),
        opens:0,
        clicks:0,
        mql:0,
        sqlAccounts:new Set(),
        dealAccounts:new Set()
      };
      const acc = accountById.get(e.account_id);
      item.accounts.add(e.account_id);
      if (/打开|浏览|触达/.test(e.type || "") || /打开|浏览/.test(e.note || "")) item.opens++;
      if (/点击|下载|提交|咨询|报名|留资/.test([e.type,e.note].join(" "))) item.clicks++;
      if (/MQL|咨询|留资|报名/.test([e.type,e.note].join(" "))) item.mql++;
      if (acc?.opportunityCount > 0 || /SQL|商机/.test(e.type || "")) item.sqlAccounts.add(e.account_id);
      if (acc?.dealCustomer || /成交/.test(e.type || "")) item.dealAccounts.add(e.account_id);
      byContent.set(key, item);
    });
    const rows = Array.from(byContent.values()).sort((a,b)=> b.accounts.size-a.accounts.size || b.clicks-a.clicks).slice(0,16);
    $("contentRows").innerHTML = rows.map(r=>{
      const denom = Math.max(1, r.accounts.size);
      const openRate = Math.round(r.opens / denom * 100);
      const clickRate = Math.round(r.clicks / denom * 100);
      return `
        <tr>
          <td><b>${escapeHtml(r.title || "-")}</b></td>
          <td><span class="badge">${escapeHtml(r.type || "-")}</span></td>
          <td>${escapeHtml(r.persona || "样例未提供")}</td>
