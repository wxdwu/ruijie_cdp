      const createdAt = toYMD(addDays(TODAY, -(1 + Math.floor(R()*18))));
      const dueOffset = -5 + Math.floor(R()*18);
      const due = toYMD(addDays(TODAY, dueOffset));
      const statusRoll = R();
      let status = "待办";
      let doneAt = "";
      if (statusRoll < 0.30){
        status = "完成";
        doneAt = toYMD(addDays(TODAY, -Math.floor(R()*3)));
      } else if (statusRoll < 0.38){
        status = "延期";
      }
      tasks.push({
        task_id: "TSK_"+(70000+i),
        account_id: acc.account_id,
        title: pick(taskTitles),
