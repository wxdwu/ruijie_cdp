          {name:`本客户 ${a.account_name||""}`, color:"#5aa7ff", values:[
            norm(myVisit, Math.max(myVisit,peerVisit)),
            norm(myEffective, Math.max(myEffective,peerEffective)),
            norm(myFunnel, Math.max(myFunnel,peerFunnel)),
            Math.min(100, winRate),
            norm(myWin, Math.max(myWin,peerWin))
          ]},
          {name:`同行均值 (${a.industry||"行业"})`, color:"#9fb0d0", values:[
            norm(peerVisit, Math.max(myVisit,peerVisit)),
            norm(peerEffective, Math.max(myEffective,peerEffective)),
            norm(peerFunnel, Math.max(myFunnel,peerFunnel)),
            Math.min(100, peerWinRate),
            norm(peerWin, Math.max(myWin,peerWin))
          ]}
        ]
      };

      // 2) 漏斗金额 vs 同行 hBar
      const funnelChart = {
        type:"hBar", title:"漏斗金额对比 · 本客户 vs 同行均值",
        items:[
          {label:"漏斗内 · 本客户", value: Math.round(myFunnel), unit:"万", color:"#5aa7ff"},
          {label:`漏斗内 · ${a.industry||""}同行均值`, value: peerFunnel, unit:"万", color:"#9fb0d0"},
          {label:"漏斗外 · 本客户", value: Math.round(crm.sumMoneyOutFunnel__c||0), unit:"万", color:"#7ee0c8"},
          {label:`漏斗外 · ${a.industry||""}同行均值`, value: peerAvg(p=> p.crm.sumMoneyOutFunnel__c), unit:"万", color:"#9fb0d0"}
        ]
      };

      // 3) 商机阶段堆积
      const stages = ["MQL","SQL","方案","投标","谈判","成交"];
      const stageGroup = {label: a.account_name || "本客户", segs: stages.map(s=>({
        name:s, value: oppAll.filter(o=>o.stage===s).reduce((sum,o)=>sum+Math.round(o.amount/10000),0)
      }))};
      const peerStageGroup = {label: `${a.industry||""}同行均值`, segs: stages.map(s=>({
        name:s, value: peers.length ? Math.round(peerOpps.filter(o=>o.stage===s).reduce((sum,o)=>sum+o.amount/10000,0)/Math.max(1,peers.length)) : 0
      }))};
      const stageChart = {type:"stackBar", title:"商机阶段金额堆积 · 漏斗厚度对比", segNames: stages, groups:[stageGroup, peerStageGroup]};

      // 4) AI 文字洞察
      const insights = [];
      const funnelCmp = cmpTone(myFunnel, peerFunnel);
      insights.push(`<div class="hint">漏斗内金额 <b>${fmtWan(myFunnel)}</b>，<span class="badge ${funnelCmp.tone}">${funnelCmp.txt}</span>。${funnelCmp.tone==="warn"?"建议加大上层 MQL/SQL 注入。":""}</div>`);
      const visitCmp = cmpTone(myVisit, peerVisit);
      insights.push(`<div class="hint">总拜访 <b>${myVisit}</b> 次（有效 ${myEffective}），<span class="badge ${visitCmp.tone}">${visitCmp.txt}</span>。无拜访天数 ${crm.noVisitDays__c||0} 天。</div>`);
      const winCmp = cmpTone(winRate, peerWinRate);
      insights.push(`<div class="hint">商机赢率 <b>${winRate}%</b>，<span class="badge ${winCmp.tone}">${winCmp.txt}</span>。</div>`);
      const stuckStage = stages.map(s=>({s, n: oppAll.filter(o=>o.stage===s).length})).filter(x=>x.n>0).sort((x,y)=>y.n-x.n)[0];
      if (stuckStage) insights.push(`<div class="hint">商机最聚集阶段：<b>${stuckStage.s}</b>（${stuckStage.n} 个），重点突破该阶段卡点可显著抬升赢率。</div>`);

      $("c360TabContent").innerHTML = `
