  function getAccountLastInteractionDate(accountId){
    const acc = db.accounts.find(a=>a.account_id===accountId);
    const latestEvent = (db.interactions || [])
      .filter(e=> e.account_id===accountId && e.date)
      .sort((a,b)=>`${b.date || ""} ${b.time_hhmm || ""}`.localeCompare(`${a.date || ""} ${a.time_hhmm || ""}`))[0];
    return latestEvent?.date || acc?.crm?.recentActivityRecordTime || acc?.lastInteractionText?.match(/\d{4}-\d{2}-\d{2}/)?.[0] || "";
  }

  function getOpportunityWindowDate(opp){
    return opp.expected_close_date || opp.date || getAccountLastInteractionDate(opp.account_id);
  }

  function roleFromContact(contact){
    const text = [contact.roleTag, contact.role, contact.crm?.post, contact.crm?.depart].filter(Boolean).join(" ");
    if (/拍板|院长|校长|主任|总经理|董事|负责人|CIO|CTO/.test(text)) return "拍板者";
    if (/决策|信息化负责人|信息中心|信息处|信息科|主管/.test(text)) return "决策者";
    if (/评估|技术|网络|工程师|运维|架构|信息安全|IT/.test(text)) return "评估者";
    if (/采购|招采|财务|商务|供应链/.test(text)) return "采购推动者";
    return "";
  }

  function getCoverageStatus(accountId){
    const contacts = (db?.contacts || []).filter(c=> c.account_id===accountId);
    const roleSet = new Set();
    contacts.forEach(c=>{
      const role = ROLE_REQUIREMENTS.includes(c.roleTag) ? c.roleTag : roleFromContact(c);
      if (role) roleSet.add(role);
    });
    const missing = ROLE_REQUIREMENTS.filter(role=> !roleSet.has(role));
    const active = contacts.filter(c=> Number(c.interactionCount || c.crm?.contactScore || 0) > 0).length;
    return {
      covered: Array.from(roleSet),
      missing,
      activeContacts: active,
      contactCount: contacts.length,
      score: `${roleSet.size}/4`
    };
  }

  filteredCampaignScope = function(campaignId){
    const scope = getCampaignScope(campaignId);
    const start = $("dateStart")?.value || "";
    const end = $("dateEnd")?.value || "";
    const channel = $("fChannel")?.value || state.filterChannel || "";
    const industry = $("fIndustry")?.value || state.filterIndustry || "";
    let accs = scope.accs.slice();
    if (industry) accs = accs.filter(a=> a.industry===industry);
    const ids = new Set(accs.map(a=>a.account_id));
    let evs = scope.evs.filter(e=> ids.has(e.account_id));
    if (start) evs = evs.filter(e=> !e.date || e.date >= start);
    if (end) evs = evs.filter(e=> !e.date || e.date <= end);
    if (channel) evs = evs.filter(e=> e.channel===channel);
    let opps = scope.opps.filter(o=> ids.has(o.account_id));
    if (start || end) opps = opps.filter(o=> dateInRange(getOpportunityWindowDate(o), start, end));
    const eventIds = new Set(evs.map(e=>e.account_id));
    const oppIds = new Set(opps.map(o=>o.account_id));
    if (channel || start || end) accs = accs.filter(a=> eventIds.has(a.account_id) || (!channel && oppIds.has(a.account_id)));
    const finalIds = new Set(accs.map(a=>a.account_id));
    return {
      accs,
      contacts: scope.contacts.filter(c=> finalIds.has(c.account_id)),
      evs: evs.filter(e=> finalIds.has(e.account_id)),
      opps: opps.filter(o=> finalIds.has(o.account_id)),
      contents: scope.contents
    };
  };

