  FIELD_SOURCES["AI搜索筛选"] = "来源：全部原始数据导出.md 7张样例表；字段：客户名/专项/行业/省份/负责人/阶段/互动渠道/互动内容标题/内容类型/互动次数；计算：前端从自然语言抽取实体，先复用 ABM 客户筛选，再叠加互动内容类型与关键词匹配；空值：样例未提供则显示未知或0。";
  FIELD_SOURCES["AI结果补充"] = "来源：全部原始数据导出.md 聚合后的客户、联系人、内容、互动记录；字段：客户名称/联系人/互动次数/内容标题/内容类型/最近互动；计算：严格命中不足20条时，按同专项、互动阈值、内容类型与关键词相似度补充样例客户；空值：没有精确内容命中时标记为样例补充。";

  const AI_CONTENT_TYPE_RULES = [
    {value:"直播", aliases:["直播回放", "直播", "回放", "报名"]},
    {value:"邮件", aliases:["EDM", "edm", "邮件", "打开邮件", "点击邮件"]},
    {value:"官网", aliases:["官网", "网页", "页面", "浏览", "网站"]},
    {value:"资料", aliases:["资料", "白皮书", "案例", "方案", "PPT", "ppt", "文档", "下载", "手册"]}
  ];

  function addAiEntity(entities, key, value, label){
    if (value === "" || value == null) return;
    if (entities[key] === value) return;
    entities[key] = value;
    entities.chips = entities.chips || [];
    if (!entities.chips.some(item=> item.key===key && item.value===value)) entities.chips.push({key, value, label});
  }

  function detectAiContentType(text){
    const q = String(text || "");
    const rule = AI_CONTENT_TYPE_RULES.find(item=> item.aliases.some(alias=> q.includes(alias)));
    return rule?.value || "";
  }

  function cleanupAiKeyword(text){
    return String(text || "")
      .replace(/^(过|了|的|相关|有关|关于)+/g, "")
      .replace(/(相关|有关|关于|的)?(内容|客户|列表|结果)$/g, "")
      .replace(/[，。；;、\s]+$/g, "")
      .trim();
  }

  function extractAiContentEntities(q, entities){
    const type = detectAiContentType(q);
    if (type) addAiEntity(entities, "contentType", type, `内容类型=${type}`);
    const keywordMatch = String(q || "").match(/(?:阅读过|看过|浏览过|下载过|点击过|打开过|访问过|读过)(.+?)(?:的客户|客户|且|并且|并|，|。|；|;|$)/);
    const keyword = cleanupAiKeyword(keywordMatch?.[1] || "");
    if (keyword && keyword.length <= 32) addAiEntity(entities, "contentKeyword", keyword, `关键词=${keyword}`);
  }

  parseCustomerQuery = function(text){
    const q = String(text || "");
    const entities = {interactionMin:0, chips:[]};
    const campaign = (db.campaigns || []).find(c=> q.includes(c.special) || q.includes(c.short) || (c.campaign_id.includes("MED") && /(医疗|医院|SMP|终端准入|EDN)/i.test(q)) || (c.campaign_id.includes("CG") && /(彩光|全光|光模块)/.test(q)));
    if (campaign) addAiEntity(entities, "campaignId", campaign.campaign_id, `专项=${campaign.special}`);
    const industries = Array.from(new Set((db.accounts || []).map(a=>a.industry).filter(Boolean)));
    const industry = industries.find(x=> x !== "未知" && q.includes(x)) || (/医疗|医院/.test(q) ? "医疗" : "");
    if (industry) addAiEntity(entities, "industry", industry, `行业=${industry}`);
    const provinces = Array.from(new Set((db.accounts || []).map(a=>a.region || a.province).filter(Boolean)));
    const province = provinces.find(x=> x !== "未知" && q.includes(x));
    if (province) addAiEntity(entities, "province", province, `省份=${province}`);
    const owner = Array.from(new Set((db.accounts || []).map(a=>a.owner).filter(Boolean))).find(x=> x !== "未知" && q.includes(x));
    if (owner) addAiEntity(entities, "owner", owner, `负责人=${owner}`);
    ["问题识别","解决方案探索","需求构建","线索","SQL","方案","投标","谈判","成交","已下单"].forEach(s=>{ if (!entities.stage && q.includes(s)) addAiEntity(entities, "stage", s, `阶段=${s}`); });
    const account = (db.accounts || []).find(a=> a.name && a.name.length > 3 && q.includes(a.name));
    if (account) addAiEntity(entities, "text", account.name, `客户=${account.name}`);
    const interact = q.match(/互动(?:次数)?\s*(?:大于|超过|不少于|不低于|>=|≥)?\s*(\d+)/);
    if (interact) addAiEntity(entities, "interactionMin", Number(interact[1]), `互动次数≥${interact[1]}`);
    const amount = q.match(/金额\s*(?:大于|超过|不少于|不低于|>=|≥)?\s*(\d+(?:\.\d+)?)/);
    if (amount) addAiEntity(entities, "amountMin", Number(amount[1]), `金额≥${amount[1]}万`);
    if (/有商机|存在商机|商机客户/.test(q)) addAiEntity(entities, "hasOpportunity", true, "有商机=是");
    if (/对单|已成交|已下单|成交客户/.test(q)) addAiEntity(entities, "dealCustomer", true, "对单客户=是");
    ["官网","直播","邮件"].forEach(ch=>{ if (!entities.channel && (q.includes(`${ch}渠道`) || q.includes(`渠道${ch}`) || q.includes(ch))) addAiEntity(entities, "channel", ch, `渠道=${ch}`); });
    extractAiContentEntities(q, entities);
    return entities;
  };

  function buildAiSearchContext(){
    const contentById = new Map((db.contents || []).map(item=>[item.content_id, item]));
    const eventsByAccount = new Map();
    (db.interactions || []).forEach(event=>{
      if (!eventsByAccount.has(event.account_id)) eventsByAccount.set(event.account_id, []);
      eventsByAccount.get(event.account_id).push(event);
    });
    eventsByAccount.forEach(list=> list.sort((a,b)=> `${b.date || ""} ${b.time_hhmm || ""}`.localeCompare(`${a.date || ""} ${a.time_hhmm || ""}`)));
    const contactsByAccount = new Map();
    (db.contacts || []).forEach(contact=>{
      if (!contactsByAccount.has(contact.account_id)) contactsByAccount.set(contact.account_id, []);
      contactsByAccount.get(contact.account_id).push(contact);
    });
    return {contentById, eventsByAccount, contactsByAccount};
  }

  function getAiAccountSignal(account, ctx){
    const events = ctx.eventsByAccount.get(account.account_id) || [];
    const contacts = ctx.contactsByAccount.get(account.account_id) || [];
    const contentRows = events.map(event=> ctx.contentById.get(event.content_id)).filter(Boolean);
    const textParts = [
      account.name, account.specialName, account.industry, account.region, account.province, account.owner,
      account.stage, account.pipelineStage, account.businessScenario, account.lastInteractionText,
      (account.tags || []).join(" "), (account.painPoints || []).join(" "), (account.historyProductLines || []).join(" "),
      (account.channels || []).join(" "),
      ...contacts.flatMap(c=> [c.name, c.role, c.roleTag, c.contentInterest, c.productInterest, c.lastInteraction]),
      ...events.flatMap(e=> [e.type, e.channel, e.note, e.actor_name, e.actor_role]),
      ...contentRows.flatMap(c=> [c.title, c.type, c.topic, c.contentInterest, c.productInterest])
    ];
    const allText = textParts.filter(Boolean).join(" ");
    const latestEvent = events[0];
    const latestContent = latestEvent?.content_id ? ctx.contentById.get(latestEvent.content_id) : null;
    const firstContent = latestContent || contentRows[0] || null;
    const displayType = detectAiContentType([firstContent?.type, firstContent?.title, latestEvent?.type, latestEvent?.channel, account.lastInteractionText].filter(Boolean).join(" ")) || firstContent?.type || latestEvent?.channel || "-";
    const recent = account.lastInteractionText || (latestEvent ? `${latestEvent.type || "-"} · ${latestEvent.channel || "-"} · ${latestEvent.date || "-"}` : "-");
    return {events, contacts, contentRows, allText, latestEvent, firstContent, displayType, recent};
  }

  function scoreAiAccount(account, entities, ctx){
    const signal = getAiAccountSignal(account, ctx);
    const text = signal.allText.toLowerCase();
    let score = Number(account.contactInteractionCount || 0) * 2 + Number(account.opportunityCount || 0) * 4 + Number(account.amountWan || 0) / 100;
    if (entities.campaignId && (account.campaign_ids || [account.campaign_id]).includes(entities.campaignId)) score += 80;
    if (entities.industry && account.industry === entities.industry) score += 45;
    if (entities.province && (account.region === entities.province || account.province === entities.province)) score += 28;
    if (entities.channel && ((account.channels || []).includes(entities.channel) || signal.events.some(e=> e.channel === entities.channel))) score += 24;
    if (entities.interactionMin != null && Number(account.contactInteractionCount || 0) >= Number(entities.interactionMin || 0)) score += 20;
    if (entities.hasOpportunity && Number(account.opportunityCount || 0) > 0) score += 20;
    if (entities.contentType && text.includes(entities.contentType.toLowerCase())) score += 36;
    if (entities.contentKeyword && text.includes(String(entities.contentKeyword).toLowerCase())) score += 60;
    return score;
  }

  function accountMatchesAiContent(account, entities, ctx){
    if (!entities.contentType && !entities.contentKeyword) return true;
    const signal = getAiAccountSignal(account, ctx);
    const text = signal.allText.toLowerCase();
    const typeOk = !entities.contentType || text.includes(String(entities.contentType).toLowerCase()) || detectAiContentType(signal.allText) === entities.contentType;
    const keywordOk = !entities.contentKeyword || text.includes(String(entities.contentKeyword).toLowerCase());
    return typeOk && keywordOk;
  }

  function relaxedAiEntities(entities, level){
    const next = {...entities, chips:[...(entities.chips || [])]};
    delete next.contentType;
    delete next.contentKeyword;
    if (level >= 1){ delete next.text; delete next.amountMin; }
    if (level >= 2){ delete next.province; delete next.owner; delete next.stage; delete next.hasOpportunity; delete next.dealCustomer; }
    if (level >= 3){ delete next.industry; delete next.channel; }
    if (level >= 4){ delete next.campaignId; next.interactionMin = 0; }
    return next;
  }

  function filterAccountsForAiQuery(entities){
    const ctx = buildAiSearchContext();
    const baseRows = filterAccountsByEntities(entities);
    const hasContentFilter = !!(entities.contentType || entities.contentKeyword);
    const strictRows = hasContentFilter ? baseRows.filter(account=> accountMatchesAiContent(account, entities, ctx)) : baseRows;
    const items = strictRows.map(account=>({account, supplemented:false, score:scoreAiAccount(account, entities, ctx)}));
    const seen = new Set(items.map(item=> item.account.account_id));
    const minRows = 20;
    if (items.length < minRows){
      const pools = [baseRows];
      for (let level=1; level<=4; level += 1) pools.push(filterAccountsByEntities(relaxedAiEntities(entities, level)));
      const candidates = Array.from(new Map(pools.flat().map(account=>[account.account_id, account])).values())
        .filter(account=> !seen.has(account.account_id))
        .map(account=>({account, supplemented:true, score:scoreAiAccount(account, entities, ctx)}))
        .sort((a,b)=> b.score - a.score || Number(b.account.contactInteractionCount || 0) - Number(a.account.contactInteractionCount || 0));
      candidates.forEach(item=>{
        if (items.length >= minRows) return;
        items.push(item);
        seen.add(item.account.account_id);
      });
    }
    items.sort((a,b)=> Number(b.supplemented) - Number(a.supplemented) ? Number(a.supplemented) - Number(b.supplemented) : b.score - a.score);
    return {items, strictCount: strictRows.length, supplementedCount: items.filter(item=>item.supplemented).length, ctx};
  }

  function toAiResultRow(item, entities, ctx){
    const account = item.account;
    const signal = getAiAccountSignal(account, ctx);
    const contentTitle = signal.firstContent?.title || (entities.contentKeyword ? `${entities.contentKeyword}（样例补充）` : account.lastInteractionText || "-");
    const matchReason = item.supplemented
      ? `样例补充：按同专项/互动阈值/内容相似度补齐，最近互动为 ${signal.recent}`
      : `严格命中：互动内容、类型或关键词与提问条件匹配，最近互动为 ${signal.recent}`;
    return {
      account_id: account.account_id,
      name: account.name,
      campaign: account.specialName || account.special || "-",
      industry: account.industry || "-",
      region: account.region || account.province || "-",
      interactions: account.contactInteractionCount || 0,
      opps: account.opportunityCount || 0,
      amount: account.amountWan || 0,
      contactCount: account.contactCount || (signal.contacts || []).length || 0,
      contentType: entities.contentType || signal.displayType || "-",
      keyword: entities.contentKeyword || "-",
      contentTitle,
      recent: signal.recent,
      matchReason,
      supplemented: item.supplemented
    };
  }

  function buildAiAccountSearchResponse(text){
    const q = String(text || "");
    if (!/(找|查|筛|列|客户|互动|商机|对单|金额|行业|省|官网|直播|邮件|专项|负责人|阅读|看过|浏览|下载|点击|打开|资料|关键词|内容|EDM)/i.test(q)) return null;
    const entities = parseCustomerQuery(q);
    if (!entities.chips.length && !/客户/.test(q)) return null;
    const result = filterAccountsForAiQuery(entities);
    const rows = result.items.map(item=> item.account);
    state.lastAiRows = rows;
    state.lastAiEntities = entities;
    const chips = entities.chips.length ? entities.chips.map(c=>c.label) : ["未提取到明确筛选项，返回全部客户"];
    const displayRows = result.items.slice(0, 20).map(item=> toAiResultRow(item, entities, result.ctx));
    return {
      text:`命中 ${rows.length} 个客户，其中严格命中 ${result.strictCount} 个；${result.supplementedCount ? `已按提问内容补充 ${result.supplementedCount} 条样例，保证列表不少于 20 条。` : "无需补充样例。"}`,
      entityChips: chips,
      resultRows: displayRows,
      resultSummary: {total:rows.length, strict:result.strictCount, supplemented:result.supplementedCount, shown:displayRows.length},
      cards:[
        {label:"展示客户", value:`${displayRows.length}条`},
        {label:"严格命中", value:`${result.strictCount}家`},
        {label:"样例补充", value:`${result.supplementedCount}家`},
        {label:"筛选口径", value:"内容类型+关键词+互动次数"}
      ],
      highlights: displayRows.slice(0,6).map(r=>`${r.name}｜${r.industry}｜${r.region}｜互动${r.interactions}次｜${r.contentType}｜${r.supplemented ? "样例补充" : "严格命中"}`),
      actions:["可导出当前 AI 查询结果为 Excel 可打开的 .xls 文件"],
      sql:"口径：先按客户/专项/行业/省份/商机/金额/互动次数筛选，再从互动记录、内容标题、内容类型、邮件/官网/直播渠道中匹配关键词；严格结果不足20条时按相似度补充样例并显式标记。",
      suggestions:["找医疗 SMP+ 专项互动次数超过3次且阅读过资料的客户", "找看过直播回放且互动次数大于2的客户", "找点击过EDM邮件且有商机的客户"],
      ops:[{type:"export_ai_results", label:"导出查询结果"}]
    };
  }

  buildAiCustomerQueryResponse = function(text){ return buildAiAccountSearchResponse(text); };
  buildSampleCustomerQueryResponse = function(text){ return buildAiAccountSearchResponse(text); };
