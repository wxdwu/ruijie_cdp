      const openOpps = opps.filter(o=> !["成交","流失"].includes(o.stage));
      const openAmtWan = Math.round(openOpps.reduce((s,o)=> s + o.amount, 0) / 10000);
      const overdueTasks = db.tasks.filter(t=> t.account_id===a.account_id && (t.status==="待办" || t.status==="延期") && t.due < today).length;
      const priority = hotness.hot >= 80 || (a.intent_score >= 85 && ["SQL","方案","投标","谈判"].includes(a.pipelineStage));
      return {a, ...hotness, openOpps: openOpps.length, openAmtWan, overdueTasks, priority};
    });
    const priorityAccounts = accountSignals.filter(x=> x.priority).sort((x,y)=> y.hot-x.hot || y.openAmtWan-x.openAmtWan);
    const hotList = priorityAccounts.slice(0,8);
    const linkedSqlCount = priorityAccounts.filter(x=> ["SQL","方案","投标","谈判"].includes(x.a.pipelineStage)).length;
