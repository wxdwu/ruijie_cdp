  function renderAiChart(chart){
    if (!chart || !chart.type) return "";
    const t = chart.type;
    const title = chart.title ? `<div class="aiChartTitle"><span>${escapeHtml(chart.title)}</span>${chart.sub ? `<span class="aiChartSub">${escapeHtml(chart.sub)}</span>` : ""}</div>` : "";
    const palette = ["#5aa7ff","#7ee0c8","#ffb85a","#c79bff","#ff8a8a","#5ad6e6"];
    if (t === "radar"){
      const axes = chart.axes || [];
      const series = chart.series || [];
      const W = 360, H = 230, cx = W/2, cy = H/2, R = 72;
      const N = axes.length;
      const rings = 4;
      // grid rings (polygons)
      const ringPaths = [];
      for (let r=1; r<=rings; r++){
        const pts = [];
        for (let i=0; i<N; i++){
          const ang = -Math.PI/2 + i*2*Math.PI/N;
          pts.push(`${(cx + Math.cos(ang)*R*r/rings).toFixed(1)},${(cy + Math.sin(ang)*R*r/rings).toFixed(1)}`);
        }
        ringPaths.push(`<polygon class="aiChartGrid" points="${pts.join(" ")}"/>`);
      }
      // axis lines + labels
      const axisLines = axes.map((a,i)=>{
        const ang = -Math.PI/2 + i*2*Math.PI/N;
        const x = cx + Math.cos(ang)*R, y = cy + Math.sin(ang)*R;
        const lx = cx + Math.cos(ang)*(R+14), ly = cy + Math.sin(ang)*(R+14);
        const anchor = Math.abs(Math.cos(ang)) < 0.2 ? "middle" : (Math.cos(ang) > 0 ? "start" : "end");
        return `<line class="aiChartAxis" x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}"/>
                <text class="aiChartLabel" x="${lx.toFixed(1)}" y="${(ly+3).toFixed(1)}" text-anchor="${anchor}">${escapeHtml(a)}</text>`;
      }).join("");
      // series polygons
      const max = chart.max || 100;
      const seriesSvg = series.map((s,si)=>{
        const color = s.color || palette[si % palette.length];
        const pts = s.values.map((v,i)=>{
          const ang = -Math.PI/2 + i*2*Math.PI/N;
          const rr = R * Math.max(0, Math.min(1, v/max));
          return `${(cx + Math.cos(ang)*rr).toFixed(1)},${(cy + Math.sin(ang)*rr).toFixed(1)}`;
        }).join(" ");
        return `<polygon points="${pts}" fill="${color}" fill-opacity="0.18" stroke="${color}" stroke-width="1.5"/>`;
      }).join("");
      // legend (right-side stat list)
      const legend = series.map((s,si)=>{
        const color = s.color || palette[si % palette.length];
        return `<span><i style="background:${color}"></i>${escapeHtml(s.name)}</span>`;
      }).join("");
      return `${title}<svg class="aiChartSvg" viewBox="0 0 ${W} ${H}">${ringPaths.join("")}${axisLines}${seriesSvg}</svg>${legend ? `<div class="aiChartLegend">${legend}</div>` : ""}`;
    }
    if (t === "hBar"){
      const items = chart.items || [];
      // 自适应 labelW：按最长 label 字符估算（中文按 12px 计，英文按 6.5px 计）
      const measure = s=> Array.from(String(s||"")).reduce((w,ch)=> w + (/[\u4e00-\u9fa5]/.test(ch) ? 12 : 6.5), 0);
      const labelW = Math.min(180, Math.max(78, Math.ceil(Math.max(0, ...items.map(it=> measure(it.label))) + 12)));
      const W = Math.max(320, labelW + 200);
      const rowH = 22, padTop = 8;
      const H = padTop + items.length * rowH + 8;
      const valW = 42;
      const barW = W - labelW - valW - 10;
      const max = chart.max || Math.max(1, ...items.map(x=> x.value));
      const rows = items.map((it,i)=>{
        const y = padTop + i*rowH;
        const w = barW * (it.value/max);
        const color = it.color || palette[i % palette.length];
        return `<text class="aiChartLabel" x="${labelW-6}" y="${y+13}" text-anchor="end">${escapeHtml(it.label)}</text>
                <rect x="${labelW}" y="${y+5}" width="${barW}" height="12" rx="3" fill="rgba(159,176,208,.10)"/>
                <rect x="${labelW}" y="${y+5}" width="${w.toFixed(1)}" height="12" rx="3" fill="${color}"/>
                <text class="aiChartValueLabel" x="${labelW+barW+4}" y="${y+14}" text-anchor="start">${escapeHtml(String(it.value))}${it.unit||""}</text>`;
      }).join("");
      return `${title}<svg class="aiChartSvg" viewBox="0 0 ${W} ${H}">${rows}</svg>`;
    }
    if (t === "stackBar"){
      // groups: [{label, segs:[{name,value}]}]
      const groups = chart.groups || [];
      const segNames = chart.segNames || [];
      const W = 320, padTop = 12, padBot = 22, chartH = 110;
      const H = padTop + chartH + padBot;
      const groupW = W / Math.max(1, groups.length);
      const barW = Math.min(28, groupW * 0.5);
      const totals = groups.map(g=> g.segs.reduce((s,x)=> s+x.value, 0));
      const max = chart.max || Math.max(1, ...totals);
      const segs = groups.map((g, gi)=>{
        const x = gi*groupW + (groupW - barW)/2;
        let yCur = padTop + chartH;
        let cumulative = 0;
        const stacks = g.segs.map((seg, si)=>{
          const h = (seg.value/max) * chartH;
          yCur -= h;
          cumulative += seg.value;
          const color = seg.color || palette[si % palette.length];
          return `<rect x="${x.toFixed(1)}" y="${yCur.toFixed(1)}" width="${barW}" height="${h.toFixed(1)}" fill="${color}"/>`;
        }).join("");
        return `${stacks}
                <text class="aiChartLabel" x="${(x+barW/2).toFixed(1)}" y="${(padTop+chartH+14).toFixed(1)}" text-anchor="middle">${escapeHtml(g.label)}</text>
                <text class="aiChartValueLabel" x="${(x+barW/2).toFixed(1)}" y="${(yCur-3).toFixed(1)}" text-anchor="middle">${cumulative}</text>`;
      }).join("");
      const baseY = padTop + chartH;
      const legend = segNames.map((n,si)=>{
        const color = palette[si % palette.length];
        return `<span><i style="background:${color}"></i>${escapeHtml(n)}</span>`;
      }).join("");
      return `${title}<svg class="aiChartSvg" viewBox="0 0 ${W} ${H}"><line class="aiChartAxis" x1="0" y1="${baseY}" x2="${W}" y2="${baseY}"/>${segs}</svg>${legend ? `<div class="aiChartLegend">${legend}</div>` : ""}`;
    }
    if (t === "line"){
      // series: [{name, values:[{x,y}]}], xLabels (optional)
      const series = chart.series || [];
      const xLabels = chart.xLabels || [];
      const W = 320, padL = 24, padR = 10, padTop = 10, padBot = 22;
      const chartH = 110;
      const H = padTop + chartH + padBot;
      const N = Math.max(1, ...series.map(s=> s.values.length));
      const allVals = series.flatMap(s=> s.values.map(v=> v.y));
      const max = chart.max || Math.max(1, ...allVals);
      const stepX = (W - padL - padR) / Math.max(1, N-1);
      // grid horizontal
      const gridLines = [0,0.5,1].map(p=>{
        const y = padTop + chartH * (1-p);
        return `<line class="aiChartGrid" x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}"/>`;
      }).join("");
      const seriesSvg = series.map((s,si)=>{
        const color = s.color || palette[si % palette.length];
        const pts = s.values.map((v,i)=>{
          const x = padL + i*stepX;
          const y = padTop + chartH * (1 - v.y/max);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        });
        const area = `M ${pts[0]} L ${pts.join(" L ")} L ${(padL + (s.values.length-1)*stepX).toFixed(1)},${padTop+chartH} L ${padL.toFixed(1)},${padTop+chartH} Z`;
        return `<path d="${area}" fill="${color}" fill-opacity="0.14"/>
                <polyline fill="none" stroke="${color}" stroke-width="1.6" points="${pts.join(" ")}"/>
                ${s.values.map((v,i)=>{ const x = padL + i*stepX; const y = padTop + chartH * (1 - v.y/max); return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.5" fill="${color}"/>`; }).join("")}`;
      }).join("");
      const xTicks = xLabels.map((lab,i)=>{
        const x = padL + i*stepX;
        return `<text class="aiChartLabel" x="${x.toFixed(1)}" y="${(padTop+chartH+14).toFixed(1)}" text-anchor="middle">${escapeHtml(lab)}</text>`;
      }).join("");
      const legend = series.map((s,si)=>{
        const color = s.color || palette[si % palette.length];
        return `<span><i style="background:${color}"></i>${escapeHtml(s.name)}</span>`;
      }).join("");
      return `${title}<svg class="aiChartSvg" viewBox="0 0 ${W} ${H}">${gridLines}${seriesSvg}${xTicks}</svg>${series.length > 1 ? `<div class="aiChartLegend">${legend}</div>` : ""}`;
    }
    return "";
  }

  function sqlToEntities(sql){
    if (!sql) return [];
    const out = [];
    const fieldLabel = {
      account_id: "客户",
      campaign_id: "专项",
      contact_id: "联系人",
      stat_date: "统计日期",
      stat_window: "统计窗口",
      industry: "行业",
      owner: "负责人",
      region: "区域"
    };
    const tableLabel = {
      dws_abm_account_360: "客户 360 主档",
      dws_account_risk_profile: "客户风险画像",
      dws_campaign_risk_accounts: "专项风险客户",
      dws_account_budget_output: "客户预算与历史产出",
      dws_content_recommendation: "内容推荐",
      dws_campaign_tag_content_map: "专项标签内容映射",
      dws_account_channel_engagement: "客户渠道互动",
      dws_campaign_account_segmentation: "专项客户分层",
      dws_campaign_comparison: "专项横向对比",
      dws_owner_execution_dashboard: "负责人执行看板",
      dws_contact_priority_recommendation: "联系人优先推进",
      dws_priority_accounts: "优先级客户",
      dws_campaign_healthcheck: "专项健康度",
      dws_campaign_summary: "专项总览"
    };
    const fromMatch = sql.match(/FROM\s+([\w_]+)/i);
    if (fromMatch){
      const t = fromMatch[1];
      out.push({label:"数据源", value: tableLabel[t] || t});
    }
    // 解析 WHERE 中的 key='value'
    const whereRe = /(\w+)\s*=\s*'([^']+)'/g;
    let m;
    while ((m = whereRe.exec(sql))){
      const key = m[1];
      let val = m[2];
      if (key === "account_id"){
        const a = (db.accounts || []).find(x=> x.account_id === val);
        if (a) val = a.name;
      } else if (key === "campaign_id"){
        const c = (db.campaigns || []).find(x=> x.campaign_id === val);
        if (c) val = c.name;
      } else if (key === "contact_id"){
        const c = (db.contacts || []).find(x=> x.contact_id === val);
        if (c) val = c.name;
      }
      out.push({label: fieldLabel[key] || key, value: val});
    }
    // SELECT 列 → 提取维度（截断展示前 6 项）
    const colLabel = {
      account_id:"客户", account_name:"客户名称", contact_id:"联系人", campaign_id:"专项", campaign_name:"专项名称",
      special_name:"专项", purchase_stage:"采购阶段", pipeline_stage:"销售阶段", intent_score:"合作意向分",
      missing_roles:"缺失关键人", approval_status:"审批状态", do_not_disturb:"免打扰",
      departmental_risk_warning:"部门风险预警", sanction_risk_warning:"制裁风险预警",
      product_budget:"产品预算", lan_budget:"LAN 预算", wan_budget:"WAN 预算", datacenter_budget:"数据中心预算",
      total_current_output:"当前总产出", history_win:"历史中标", content_title:"内容标题",
      persona_fit:"角色契合", content_interest:"内容兴趣", product_interest:"产品兴趣",
      tag_name:"标签", account_count:"客户数", top_content_title:"Top 内容", top_content_clicks:"内容点击",
      channel:"渠道", interaction_count:"互动次数", high_value_interaction_count:"高价值互动",
      customer_tier:"客户分层", is_old_account:"老客户", must_follow:"必跟标记", top_tags:"Top 标签",
      won_count:"成交数", sql_count:"SQL 数", high_intent_accounts:"高意向客户数",
      role_gap_accounts:"角色缺口客户", owner:"负责人", overdue_tasks:"超期任务",
      priority_score:"优先级分", recommended_channel:"推荐渠道", priority_reason:"优先推进原因",
      risk_account_count:"风险客户数", stat_date:"统计日期"
    };
    const selMatch = sql.match(/SELECT\s+([\s\S]+?)\s+FROM/i);
    if (selMatch){
      const cols = selMatch[1].split(",").map(s=>s.trim()).filter(Boolean).map(c=> colLabel[c] || c);
      if (cols.length){
        const shown = cols.slice(0,6).join(" / ") + (cols.length > 6 ? ` …(+${cols.length-6})` : "");
        out.push({label:"提取维度", value: shown});
      }
    }
    // ORDER BY / LIMIT 提示
    const limitMatch = sql.match(/LIMIT\s+(\d+)/i);
    if (limitMatch) out.push({label:"取样", value: `Top ${limitMatch[1]}`});
    return out;
  }

