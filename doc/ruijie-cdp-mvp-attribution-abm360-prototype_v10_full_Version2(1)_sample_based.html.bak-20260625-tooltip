  function renderOpportunityDistribution(campaignId, opps){
    const grouped = new Map();
    opps.forEach(o=>{
      const key = o.prediction || "未知";
      const item = grouped.get(key) || {name:key, open:0, lost:0, deal:0};
      if (o.stage === "成交") item.deal++;
      else if (o.stage === "流失" || o.lost) item.lost++;
      else item.open++;
      grouped.set(key, item);
    });
    const rows = Array.from(grouped.values()).sort((a,b)=> (b.open+b.lost+b.deal) - (a.open+a.lost+a.deal));
    const max = Math.max(...rows.map(x=>x.open+x.lost+x.deal), 1);
    $("funnel").innerHTML = `
      <div class="chartHead"><div><div class="chartTitle">商机预测类别分布 ${sourceTip("商机预测类别分布")}</div><div class="chartSub">按 CRM 预测类别聚合，并区分未丢单、已丢单、已下单</div></div><div class="chartLegend">Opportunity forecast</div></div>
      <div style="margin-top:12px; display:flex; flex-direction:column; gap:10px;">
        ${rows.map(r=>{
          const total = r.open + r.lost + r.deal;
          return `<div class="barRow"><div class="name">${escapeHtml(r.name)}</div><div class="barWrap"><div class="bar" style="width:${Math.max(3, Math.round(total/max*100))}%"></div></div><div class="val">未丢单${r.open} / 丢单${r.lost} / 下单${r.deal}</div></div>`;
