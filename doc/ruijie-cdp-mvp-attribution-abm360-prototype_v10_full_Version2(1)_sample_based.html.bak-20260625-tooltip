  function getCampaignScope(campaignId){
    const accs = (db?.accounts || []).filter(a=> (a.campaign_ids || [a.campaign_id]).includes(campaignId));
    const accountIds = new Set(accs.map(a=> a.account_id));
    const contacts = (db?.contacts || []).filter(c=> accountIds.has(c.account_id));
    const evs = (db?.interactions || []).filter(e=> accountIds.has(e.account_id));
    const opps = (db?.opps || []).filter(o=> accountIds.has(o.account_id));
    const contents = (db?.contents || []).filter(c=> (c.campaign_ids || [c.campaign_id]).includes(campaignId));
    return {accs, contacts, evs, opps, contents};
  }

  function getCoverageStatus(accountId){
    const contacts = (db?.contacts || []).filter(c=> c.account_id===accountId);
    const active = contacts.filter(c=> Number(c.interactionCount || c.crm?.contactScore || 0) > 0).length;
    return {
      covered: contacts.map(c=>c.name).slice(0,4),
      missing: [],
      score: `${contacts.length}人 / 互动${active}人`
    };
  }

  function filteredCampaignScope(campaignId){
    const scope = getCampaignScope(campaignId);
    const start = $("dateStart")?.value || "";
    const end = $("dateEnd")?.value || "";
    const channel = $("fChannel")?.value || state.filterChannel || "";
    const industry = $("fIndustry")?.value || state.filterIndustry || "";
    let accs = scope.accs.slice();
    if (industry) accs = accs.filter(a=> a.industry===industry);
    const ids = new Set(accs.map(a=>a.account_id));
    let evs = scope.evs.filter(e=> ids.has(e.account_id));
    if (start) evs = evs.filter(e=> !e.date || e.date >= start);
    if (end) evs = evs.filter(e=> !e.date || e.date <= end);
    if (channel) evs = evs.filter(e=> e.channel===channel);
    const eventIds = new Set(evs.map(e=>e.account_id));
    if (channel || start || end) accs = accs.filter(a=> eventIds.has(a.account_id) || (a.opportunityCount && !channel));
    const finalIds = new Set(accs.map(a=>a.account_id));
    return {
      accs,
      contacts: scope.contacts.filter(c=> finalIds.has(c.account_id)),
      evs: evs.filter(e=> finalIds.has(e.account_id)),
      opps: scope.opps.filter(o=> finalIds.has(o.account_id)),
      contents: scope.contents
    };
  }

  function renderPie(host, items, title, sub){
    if (!host) return;
    const colors = ["#4da3ff", "#2dd4bf", "#f6c65b"];
    const total = items.reduce((sum, item)=> sum + Number(item.value || 0), 0);
    let acc = 0;
    const segs = items.map((item, idx)=>{
      const value = Number(item.value || 0);
      const start = acc / Math.max(1,total) * Math.PI * 2;
      acc += value;
      const end = acc / Math.max(1,total) * Math.PI * 2;
      const large = end - start > Math.PI ? 1 : 0;
      const rOuter = 76, rInner = 42, cx = 95, cy = 95;
      const p = (r, a)=> [cx + Math.cos(a - Math.PI/2)*r, cy + Math.sin(a - Math.PI/2)*r];
      const [x1,y1] = p(rOuter,start), [x2,y2] = p(rOuter,end), [x3,y3] = p(rInner,end), [x4,y4] = p(rInner,start);
      if (!value) return "";
      return `<path d="M ${x1} ${y1} A ${rOuter} ${rOuter} 0 ${large} 1 ${x2} ${y2} L ${x3} ${y3} A ${rInner} ${rInner} 0 ${large} 0 ${x4} ${y4} Z" fill="${colors[idx]}"></path>`;
    }).join("");
    host.innerHTML = `
