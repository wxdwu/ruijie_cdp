  function runAiDrawerAction(actionEl){
    const type = actionEl.dataset.aiAction || "";
    const account = db.accounts.find((item)=> item.account_id===actionEl.dataset.aiAccount) || getAiPrimaryAccount();
    if (type === "go_campaign"){
      closeAiDrawer();
      setView("campaign");
      renderCampaign();
      return;
    }
    if (type === "go_cockpit"){
      closeAiDrawer();
      setView("cockpit");
      renderCockpit();
      return;
    }
    if (!account) return;
    const topOpp = getAccountTopOpp(account.account_id);
    const keyTopics = [account.businessScenario, ...account.painPoints.slice(0,2)].filter(Boolean).join("、") || account.specialName;
    const competitor = topOpp?.competitor?.[0] || "主流竞品";
    const targets = getAiActionContactTargets(account);

    if (type === "open_customer_360"){
      closeAiDrawer();
      if (state.view === "customer360") renderCustomer360(account.account_id, "abm");
      else openCustomer360(account.account_id, state.view === "campaign" ? "campaign" : (state.view === "cockpit" ? "cockpit" : "abm"));
      return;
    }
    if (type === "risk_task"){
      createTaskForAccount(account, "合规/风险核验", 1);
      showToast("核验任务已创建");
      return;
    }
    if (type === "create_task"){
      createTaskForAccount(account, actionEl.dataset.aiTaskTitle || `推进${account.name}`, Number(actionEl.dataset.aiDueDays || 2));
      showToast("任务已创建");
      return;
    }
    if (type === "add_contact"){
      openAddContactModal(account, actionEl.dataset.aiRoleNeed || getCoverageStatus(account.account_id).missing[0] || "关键联系人");
      return;
    }
    if (type === "send_email"){
      openEmailEditorModal(account, targets.emails, `【资料】${account.industry} + ${keyTopics}`, buildMailHtml(account, keyTopics, competitor));
      return;
    }
    if (type === "send_sms"){
      openSmsModal(account, targets.phones);
      return;
    }
    if (type === "script"){
      openScriptModal(account, keyTopics, competitor);
    }
  }

