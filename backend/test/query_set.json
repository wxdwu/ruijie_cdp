    "validation_rules": {
        "sql_security": [
            "所有 SQL 只能查询以 dws_ 开头的表",
            "禁止包含 DROP、DELETE、UPDATE、INSERT、ALTER、CREATE、TRUNCATE、REPLACE 关键字",
            "customer_name 字段做 LIKE 模糊匹配，不包含 company_name"
        ],
        "schema_integrity": [
            "SQL 中使用的字段必须在 dws_customer_360 表定义中存在",
            "industry → industry (精确)",
            "region → region (精确)",
            "stage → purchase_stage (精确)",
            "intent_level → intent_level (精确)",
            "channel → last_interaction_channel (精确)",
            "keyword → customer_name LIKE (模糊)",
            "interaction_min → interaction_count_30d >= (数值)"
        ],
        "intent_validation": [
            "intent 只能是 business_query、simple_question、other 之一",
            "structured_query 为空时不应执行数据库查询",
            "非 business_query 意图的回复不应包含查询结果数据"
        ]
    }
