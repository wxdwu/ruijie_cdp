{
    "description": "AI对话功能测试数据集 — 验证意图识别和SQL生成的正确性",
    "version": "1.0",
    "created": "2026-06-17",
    "tables_reference": {
        "dws_customer_360": "客户360聚合表（唯一查询目标表）",
        "dws_contact_mapping": "跨系统联系人映射",
        "dws_contact_360": "联系人360聚合",
        "dws_interaction_detail": "互动明细",
        "dws_sync_meta": "同步状态追踪",
        "review_candidate": "审核队列"
    },
    "supported_fields": {
        "industry": "行业（精确匹配）",
        "region": "区域（精确匹配）",
        "stage": "购买阶段，对应 purchase_stage（精确匹配）",
        "intent_level": "意向等级（精确匹配）",
        "channel": "互动渠道，对应 last_interaction_channel（精确匹配）",
        "keyword": "客户名称关键词（LIKE 模糊匹配）",
        "interaction_min": "最小30天互动次数（>=比较）"
    },

    "test_cases": [
        {
            "id": "TC001",
            "category": "单条件查询",
            "description": "按行业精确查询",
            "query": "医疗行业的客户有哪些",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "industry": "医疗"
            },
            "expected_sql_condition": "industry = :industry",
            "notes": "验证单字段精确匹配"
        },
        {
            "id": "TC002",
            "category": "单条件查询",
            "description": "按区域精确查询",
            "query": "查找广东地区的所有客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "region": "广东"
            },
            "expected_sql_condition": "region = :region",
            "notes": "验证区域过滤"
        },
        {
            "id": "TC003",
            "category": "单条件查询",
            "description": "按意向等级查询",
            "query": "高意向等级的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "intent_level": "高"
            },
            "expected_sql_condition": "intent_level = :intent_level",
            "notes": "验证意向等级过滤"
        },
        {
            "id": "TC004",
            "category": "单条件查询",
            "description": "按采购阶段查询",
            "query": "处于需求构建阶段的客户有哪些",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "stage": "需求构建"
            },
            "expected_sql_condition": "purchase_stage = :stage",
            "notes": "验证采购阶段过滤"
        },
        {
            "id": "TC005",
            "category": "单条件查询",
            "description": "按互动渠道查询",
            "query": "通过微信渠道互动的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "channel": "微信"
            },
            "expected_sql_condition": "last_interaction_channel = :channel",
            "notes": "验证渠道过滤"
        },
        {
            "id": "TC006",
            "category": "单条件查询",
            "description": "按客户名称关键词模糊查询",
            "query": "查找北京首钢自动化信息技术有限公司",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "keyword": "北京首钢自动化信息技术有限公司"
            },
            "expected_sql_condition": "customer_name LIKE :keyword",
            "notes": "验证关键词 LIKE 模糊匹配，注意：表中只有 customer_name 字段，没有 company_name"
        },
        {
            "id": "TC007",
            "category": "单条件查询",
            "description": "按最小互动次数查询",
            "query": "30天内互动超过5次的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "interaction_min": 5
            },
            "expected_sql_condition": "interaction_count_30d >= :interaction_min",
            "notes": "验证数值比较过滤"
        },
        {
            "id": "TC008",
            "category": "单条件查询",
            "description": "口语化互动次数查询",
            "query": "近一个月互动至少10次的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "interaction_min": 10
            },
            "expected_sql_condition": "interaction_count_30d >= :interaction_min",
            "notes": "验证口语化表达解析为数值条件"
        },

        {
            "id": "TC009",
            "category": "多条件组合",
            "description": "行业 + 区域 + 意向等级",
            "query": "查找广东地区医疗行业高意向的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "industry": "医疗",
                "region": "广东",
                "intent_level": "高"
            },
            "expected_sql_condition": "AND industry = :industry AND region = :region AND intent_level = :intent_level",
            "notes": "验证三条件组合"
        },
        {
            "id": "TC010",
            "category": "多条件组合",
            "description": "行业 + 区域 + 采购阶段",
            "query": "教育行业北京地区处于解决方案探索阶段的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "industry": "教育",
                "region": "北京",
                "stage": "解决方案探索"
            },
            "expected_sql_condition": "AND industry = :industry AND region = :region AND purchase_stage = :stage",
            "notes": "验证三条件组合，不同字段类型"
        },
        {
            "id": "TC011",
            "category": "多条件组合",
            "description": "行业 + 互动渠道 + 互动次数",
            "query": "金融行业通过官网渠道互动超过3次的客户",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "industry": "金融",
                "channel": "官网",
                "interaction_min": 3
            },
            "expected_sql_condition": "AND industry = :industry AND last_interaction_channel = :channel AND interaction_count_30d >= :interaction_min",
            "notes": "验证精确匹配 + 模糊匹配 + 数值比较组合"
        },
        {
            "id": "TC012",
            "category": "多条件组合",
            "description": "意向等级 + 区域 + 关键词",
            "query": "上海地区有采购意向的自动化公司",
            "expected_intent": "business_query",
            "expected_structured_query": {
                "region": "上海",
                "keyword": "自动化"
            },
            "expected_sql_condition": "AND region = :region AND customer_name LIKE :keyword",
            "notes": "验证区域精确 + 关键词模糊组合"
        },
        {
            "id": "TC013",
            "category": "多条件组合",
