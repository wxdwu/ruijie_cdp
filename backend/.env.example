# ════════════════════════════════════════════════════════════════
# 后端环境配置模板（一套源码，双模式）
# ────────────────────────────────────────────────────────────────
# 本项目按 APP_ENV 加载对应的环境文件（见 app/config/config.py）：
#   APP_ENV=development  ->  backend/.env.development   本地开发，连远程云 MySQL
#   APP_ENV=production   ->  backend/.env.production    docker 部署，连本机 docker MySQL（默认）
#
# 使用方法：复制本模板为对应模式文件，填入真实值：
#   cp .env.example .env.development    # 开发
#   cp .env.example .env.production     # 生产
#
# 优先级：进程环境变量 > .env.{APP_ENV} 文件 > config.py 默认值
# 注意：.env.development / .env.production 含真实密钥，已被 .gitignore 忽略，请勿提交。
# ════════════════════════════════════════════════════════════════

# DeepSeek API Configuration (LLM 对话用) —— 生产环境请勿提交真实 api-key!!
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com

# Embedding API 独立配置（DeepSeek 不支持 /embeddings，需单独配置）
# 不配置时回退到 LLM 配置，再失败则使用 hash 兜底
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Database Configuration ───────────────────────────────────────
# 开发模式（.env.development）示例：远程云 MySQL
#   DB_HOST=192.168.159.22
#   DB_PORT=33307
#   DB_USER=root
#   DB_PASSWORD=<your-cloud-password>
#   DB_NAME=app_cdp
#
# 生产模式（.env.production）示例：本机 docker MySQL
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=123456
#   DB_NAME=app_cdp
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_cdp

# ── ElasticSearch（可选，DWS 数据检索/分析）──────────────────────
# ES_HOST=
# ES_PORT=9200
# ES_USER=elastic
# ES_PASSWORD=
# ES_SCHEME=https
# ES_INDEX_PREFIX=cdp_
# ES_VERIFY_CERTS=false

# 测试模式：限制去重时处理的公司数量（0表示不限制，建议先设置为100-500测试）
DEDUP_TEST_MODE_MAX_COMPANIES=100
