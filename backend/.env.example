# ════════════════════════════════════════════════════════════════
# 后端环境配置模板（一套源码，双模式）
# ────────────────────────────────────────────────────────────────
# 本项目按 APP_ENV 加载对应的环境文件（见 app/config/config.py）：
#   APP_ENV=development  ->  backend/.env.development   本地开发，连远程云 MySQL
#   APP_ENV=production   ->  backend/.env.production    docker 部署，连本机 docker MySQL（需显式指定）
#
# 使用方法：复制本模板为对应模式文件，填入真实值：
#   cp .env.example .env.development    # 开发
#   cp .env.example .env.production     # 生产
#
# 优先级：进程环境变量 > .env.{APP_ENV} 文件 > config.py 默认值
# 注意：.env.development / .env.production 含真实密钥，已被 .gitignore 忽略，请勿提交。
# ════════════════════════════════════════════════════════════════

# 锐捷内部网关 LLM 配置（OpenAI 兼容，默认模型 ray 智能推荐(默认)）
# 生产环境请勿提交真实 api-key!!
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://gptauth.ruijie.com.cn/v1
LLM_MODEL_NAME="ray 智能推荐(默认)"

# Embedding API 独立配置（锐捷网关同样支持 /embeddings，默认模型 text-embedding-3-small）
# 不配置时回退到 LLM 配置，再失败则使用 hash 兜底
# EMBEDDING_API_KEY 留空则回退使用上面的 LLM_API_KEY
EMBEDDING_BASE_URL=https://gptauth.ruijie.com.cn/v1
EMBEDDING_MODEL=text-embedding-3-small

# ── Database Configuration ───────────────────────────────────────
# 开发模式（.env.development）示例：远程云 MySQL
#   DB_HOST=192.168.159.22
#   DB_PORT=33307
#   DB_USER=root
#   DB_PASSWORD=<your-cloud-password>
#   DB_NAME=app_cdp
#
# 生产模式（.env.production）示例：本机 docker MySQL
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=123456
#   DB_NAME=app_cdp
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_cdp

# ── Redis 页面缓存（开发默认关闭，docker-compose 生产部署会显式开启）──────
CACHE_ENABLED=false
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=cdp
CACHE_CONNECT_TIMEOUT_MS=100
CACHE_READ_TIMEOUT_MS=100
CACHE_MAX_CONNECTIONS=50
CACHE_VALUE_MAX_BYTES=1048576
CACHE_LOCK_TTL_MS=15000
CACHE_TTL_JITTER_PERCENT=10

# ── ElasticSearch（可选，DWS 数据检索/分析）──────────────────────
# ES_HOST=
# ES_PORT=9200
# ES_USER=elastic
# ES_PASSWORD=
# ES_SCHEME=https
# ES_INDEX_PREFIX=cdp_
# ES_VERIFY_CERTS=false

# 测试模式：限制去重时处理的公司数量（0表示不限制，建议先设置为100-500测试）
DEDUP_TEST_MODE_MAX_COMPANIES=100
