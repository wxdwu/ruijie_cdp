# ────────────────────────────────────────────────────────────────
# 生产模式（APP_ENV=production）配置
# docker 部署：由 deploy/deploy.sh 自动选用本文件并注入 backend 容器。
# 数据库连「本机 docker MySQL」（deploy/docker-compose.yml，host 网络监听 127.0.0.1:3306）。
# 注意：本文件含真实密钥，已被 .gitignore 忽略，请勿提交。
# ────────────────────────────────────────────────────────────────

# DeepSeek API Configuration (LLM 对话用)
LLM_API_KEY=sk-707e060296124b14a2640b68e56f1efa
LLM_BASE_URL=https://api.deepseek.com

# Embedding API 独立配置（DeepSeek 不支持 /embeddings，需单独配置）
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Database Configuration —— 生产模式：本机 docker MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_cdp

# 测试模式：限制去重时处理的公司数量（0表示不限制）
DEDUP_TEST_MODE_MAX_COMPANIES=100
