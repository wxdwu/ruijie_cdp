# ────────────────────────────────────────────────────────────────
# 生产模式（APP_ENV=production）配置
# docker 部署：由 deploy/deploy.sh 自动选用本文件并注入 backend 容器。
# 数据库连「本机 docker MySQL」（deploy/docker-compose.yml，host 网络监听 127.0.0.1:3306）。
# 注意：本文件含真实密钥，已被 .gitignore 忽略，请勿提交。
# ────────────────────────────────────────────────────────────────

# 锐捷内部网关 LLM 配置（OpenAI 兼容，默认模型 ray 智能推荐(默认)）
LLM_API_KEY=sk-oauth-U0N752VvsSbapLAqum3IAlUSvZ7YcE1LlB1XboycYlvAbQ18
LLM_BASE_URL=https://gptauth.ruijie.com.cn/v1
LLM_MODEL_NAME="ray 智能推荐(默认)"

# Embedding API 独立配置（锐捷网关同样支持 /embeddings，默认模型 text-embedding-3-small）
# EMBEDDING_API_KEY 留空则回退使用上面的 LLM_API_KEY
EMBEDDING_BASE_URL=https://gptauth.ruijie.com.cn/v1
EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration —— 生产模式：本机 docker MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=app_cdp

# 测试模式：限制去重时处理的公司数量（0表示不限制）
DEDUP_TEST_MODE_MAX_COMPANIES=100
